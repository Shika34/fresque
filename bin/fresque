#!/bin/bash
# fresque: quality wallpapers for Omarchy, with nothing to configure.
#
# Every network call and every piece of JSON handling lives here. The QML
# surfaces (bar pill, panel, rotation service) only run this script and read
# the JSON it prints, so none of them ever builds a command string.
#
# No API key is needed for any source, and the applied image is kept locally,
# which is what makes the rotation work offline.

set -uo pipefail

CONFIG_FILE="${FRESQUE_CONFIG:-$HOME/.config/omarchy/fresque.json}"
STATE_DIR="${FRESQUE_STATE_DIR:-$HOME/.local/state/fresque}"
CURRENT_FILE="$STATE_DIR/current.json"
SEEN_FILE="$STATE_DIR/seen.tsv"
INDEX_FILE="$STATE_DIR/library.tsv"
BLOCKED_FILE="$STATE_DIR/blocked.tsv"
STAGED_FILE="$STATE_DIR/staged.tsv"

CONFIG_VERSION=10
FILE_PREFIX="fresque-"
# Delay after a failed attempt, in milliseconds: an offline laptop should retry
# in minutes, not after a whole rotation interval.
RETRY_MS=300000
# Ids remembered so a rotation never serves the same picture twice. A source with
# a small pool needs its ids to outlive a day of rotation: Bing offers eight
# pictures and adds one a day, so 400 entries were forgotten long before the
# photograph left the offer.
SEEN_KEEP=4000
# How many wallpapers are kept ready on disk. Applying one of those is instant,
# which is what makes asking for the next wallpaper feel immediate.
STAGE_MAX=4
# 64 MiB is far above any wallpaper here and far below anything that could
# fill the disk if a source misbehaves.
MAX_IMAGE_BYTES=67108864
# What a picture is allowed to cost once it is decoded. The download limits say
# nothing about that: a PNG of a few hundred kilobytes can describe a canvas of
# several gigabytes, and the renderer pays for every pixel and every text chunk
# of the file before it scales anything. 50 MP is above 8K, and 12000 px on a
# side is already four times a 4K screen.
MAX_PIXELS=50000000
MAX_SIDE=12000
# A wallpaper is kept at twice the screen it has to fill, which is invisible
# and keeps what the shell has to decode modest.
KEEP_SCALE=2
MAX_JSON_BYTES=8388608

PAGE_SIZE=50

die() { echo "fresque: $*" >&2; exit 1; }

# Path of this script, so it can re-launch itself in the background to prepare
# the next wallpapers.
SELF="${BASH_SOURCE[0]}"

# ---------------------------------------------------------------- requests

# A user agent that names the plugin, so a source's maintainers can see who is
# asking. It applies to every request, JSON or image.
USER_AGENT="fresque/2.0 (Omarchy wallpaper plugin, +https://github.com/Shika34/fresque)"

# HTTPS is required for the request and for every redirect, so a source or a
# compromised CDN cannot downgrade a fetch to plain HTTP.
#
# Every reply is also cut at a byte ceiling. --max-filesize only refuses what the
# server *announces*, and a server is free to announce nothing, ignore a range
# request and keep streaming: the timeout would then be the only limit, and the
# limit would be measured in seconds of bandwidth on the user's disk. head closes
# the pipe at the ceiling, which stops the transfer with it.
curl_json() {
  curl --proto '=https' --proto-redir '=https' --max-filesize "$MAX_JSON_BYTES" \
    --connect-timeout 10 --max-time 25 --silent --show-error --location --fail \
    -A "$USER_AGENT" -H 'Accept: application/json' "$1" |
    head -c "$((MAX_JSON_BYTES + 1))"
}

# The file is written through the same ceiling, one byte above it, so a file
# that reached the end can be told apart from one that ended on its own.
curl_file() {
  curl --proto '=https' --proto-redir '=https' --max-filesize "$MAX_IMAGE_BYTES" \
    --connect-timeout 15 --max-time 180 --silent --show-error --location --fail \
    -A "$USER_AGENT" "$1" |
    head -c "$((MAX_IMAGE_BYTES + 1))" >"$2"
}

urlencode() { jq -rn --arg v "$1" '$v|@uri'; }

# Pixel size of a remote picture, read from its first 64 KB, plus the total size
# of the file. A JPEG carries its dimensions in the header and the range reply
# carries the total length, so one cheap request answers both "is it wallpaper
# shaped" and "is it a reasonable download".
remote_probe() {
  local tmp hdr dims total
  tmp="$STATE_DIR/probe.$$" || return 1
  hdr="$STATE_DIR/probe-hdr.$$" || { rm -f "$tmp"; return 1; }
  # The body goes through a pipe so that a server which ignores the range is cut
  # at 64 KB instead of filling the state directory until the timeout. The
  # headers go to their own file, which is bounded by the same timeout.
  curl --proto '=https' --proto-redir '=https' --silent --show-error --location \
    --fail --connect-timeout 8 --max-time 20 --range 0-65535 \
    --dump-header "$hdr" -A "$USER_AGENT" "$1" 2>/dev/null |
    head -c 65536 >"$tmp"
  total=$(awk -F'/' 'tolower($1) ~ /content-range/ { gsub(/[^0-9]/, "", $2); v = $2 } END { print v }' "$hdr" 2>/dev/null)
  dims=""
  if [[ -s $tmp ]]; then dims=$(image_dimensions "$tmp"); fi
  rm -f "$tmp" "$hdr"
  [[ -n $dims ]] || return 1
  printf '%s %s' "$dims" "${total:-0}"
}

now_ms() { date +%s%3N; }

# Number of words in a list, used for the counts the panel reads back.
count_words() { local n=0 w; for w in $1; do n=$((n + 1)); done; printf '%s' "$n"; }

# Every number that comes from outside: a source's JSON, a header probe, the
# compositor, or a settings file someone edited by hand. `(( w >= 0 ))` does not
# read the value of w, it evaluates it, so a dimension shaped like an array
# subscript would have bash run the command substitution inside it. Only digits
# survive, and a value that holds no digit at all is refused.
dimension() {
  local value=${1-}
  value=${value//[!0-9]/}
  [[ -n $value && ${#value} -le 9 ]] || return 1
  printf '%s' "$value"
}

# ---------------------------------------------------------------- files

# Refuses to write into anything that is not a plain directory owned by the
# user, so a symlink planted at a guessable path cannot redirect our writes.
ensure_dir() {
  local dir=$1
  [[ -d $dir ]] || mkdir -p "$dir" || die "cannot create $dir"
  [[ -d $dir ]] || die "$dir is not a directory"
  [[ -O $dir ]] || die "$dir is not owned by you"
}

default_library() { printf '%s' "$HOME/Pictures/Fresque"; }

library_dir() {
  local dir="${FRESQUE_LIBRARY:-}"
  [[ -n $dir ]] || dir=$(cfg library)
  [[ -n $dir ]] || dir=$(default_library)
  printf '%s' "${dir/#\~/$HOME}"
}

theme_name() { cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || echo "default"; }

# Favourites live in a subfolder of the library, and the pruning code never
# looks there: a picture the user singled out is the one thing in this plugin
# that is never deleted.
favorites_dir() { printf '%s' "$(library_dir)/Favorites"; }

# A picture counts as a favourite when the favourites folder holds its file
# name, whichever of the two links the shell is currently showing.
is_current_favorite() {
  local path=$1
  [[ -n $path ]] || return 1
  [[ -e "$(favorites_dir)/$(basename "$path")" ]]
}

is_favorite_path() {
  local path=$1 base
  base=$(basename "$(dirname "$path")")
  [[ $base == "Favorites" ]]
}

# The native background picker only cycles files that sit in the theme's own
# folder, so each applied image is linked there. On one filesystem that link is
# a hardlink and costs nothing, across two it is a symlink and still costs
# nothing.
theme_dir() { printf '%s' "$HOME/.config/omarchy/backgrounds/$(theme_name)"; }

slugify() {
  local s
  s=$(printf '%s' "$1" |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/\.(jpe?g|png|webp|avif|tiff?)$//' |
    sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
  printf '%s' "${s:0:60}"
}

image_ext() {
  local u=${1%%\?*}
  case ${u##*.} in
    jpg|JPG|jpeg|JPEG) printf 'jpg' ;;
    png|PNG)           printf 'png' ;;
    webp|WEBP)         printf 'webp' ;;
    avif|AVIF)         printf 'avif' ;;
    *)                 printf 'jpg' ;;
  esac
}

# Real pixel size of a downloaded file. libvips ships with Omarchy (the image
# picker uses it), ImageMagick is a fallback, and when neither is present the
# size gate is skipped rather than blocking the plugin.
image_dimensions() {
  local out
  if command -v vipsheader >/dev/null 2>&1; then
    out=$(vipsheader "$1" 2>/dev/null | sed -n 's/.*: \([0-9][0-9]*\)x\([0-9][0-9]*\) .*/\1 \2/p')
    [[ -n $out ]] && { printf '%s' "$out"; return 0; }
  fi
  if command -v magick >/dev/null 2>&1; then
    out=$(magick identify -format '%w %h' "$1" 2>/dev/null)
    [[ -n $out ]] && { printf '%s' "$out"; return 0; }
  fi
  return 1
}

# A truncated body, an HTML error page or an SVG (which can pull in remote
# resources and blow up the renderer) must never become a wallpaper.
# The bytes, not the name. An older version named the file after the URL suffix,
# so a source that answered a .jpg request with a PNG left a PNG behind a .jpg
# name, text chunks and all. Only the first four bytes settle what a file is.
is_jpeg_file() {
  local magic
  [[ -s $1 ]] || return 1
  magic=$(head -c 4 "$1" 2>/dev/null | od -An -tx1 2>/dev/null | tr -d ' \n')
  [[ ${magic:0:6} == ffd8ff ]]
}

verify_image() {
  local file=$1 mime
  [[ -s $file ]] || return 1
  mime=$(file -b --mime-type "$file" 2>/dev/null) || return 1
  case $mime in
    image/jpeg|image/png|image/webp|image/avif) ;;
    *) return 1 ;;
  esac
  [[ $(stat -c %s "$file") -gt 20480 ]] || return 1
  return 0
}

# ---------------------------------------------------------------- config

DEFAULT_CONFIG='{
  "version": 10,
  "rotateMinutes": 1440,
  "sources": { "bing": true, "wikimedia": true, "noirlab": true, "omarchy": true, "konachan": true, "yandere": true, "picsum": true },
  "themes": { "nature": true, "space": true, "architecture": true, "animals": true, "photos": true, "anime": true },
  "keepLast": 30,
  "favoritesOnly": false,
  "language": "auto",
  "expose": true,
  "library": ""
}'

CONFIG_KEYS="rotateMinutes keepLast expose favoritesOnly language library sources.<id> themes.<id>"

ensure_config() {
  if [[ -f $CONFIG_FILE ]]; then
    local version
    version=$(jq -r '.version // 0' "$CONFIG_FILE" 2>/dev/null || echo 0)
    [[ $version == "$CONFIG_VERSION" ]] && return 0
    cp -f "$CONFIG_FILE" "$CONFIG_FILE.bak" 2>/dev/null
    # A schema change must not throw away the settings someone chose. The
    # defaults are the base and the old file is merged on top, so a chosen
    # interval survives, a source that disappeared is dropped, and a source
    # that is new here shows up with its default.
    local merged
    # The space source was rebuilt around NOIRLab, so a choice made about the
    # old one is carried over before it is dropped.
    merged=$(jq -c --argjson d "$DEFAULT_CONFIG" '
      $d * . | .version = $d.version
      | if (.sources | has("esa")) and (.sources.noirlab == null) then .sources.noirlab = .sources.esa else . end
      | del(.sources.esa)' "$CONFIG_FILE.bak" 2>/dev/null)
    if [[ -n $merged ]]; then
      printf '%s\n' "$merged" >"$CONFIG_FILE" || die "cannot write $CONFIG_FILE"
      echo "fresque: config migrated from schema v$version to v$CONFIG_VERSION (previous copy at $CONFIG_FILE.bak)" >&2
      # The pool was prepared by the version that wrote it, on its own terms.
      # Entries from before the pictures were normalised point at originals, so
      # the list is dropped and rebuilt by this version instead.
      if [[ $version -lt 9 ]]; then : >"$STAGED_FILE" 2>/dev/null || true; fi
      # The picture on screen survived the upgrade too, and the state file names
      # its file: it is brought in line before any interface reads it.
      if [[ $version -lt 10 ]]; then shape_current_wallpaper || true; fi
      return 0
    fi
    echo "fresque: config was schema v$version, replaced with v$CONFIG_VERSION" >&2
  fi
  ensure_dir "$(dirname "$CONFIG_FILE")"
  printf '%s\n' "$DEFAULT_CONFIG" >"$CONFIG_FILE" || die "cannot write $CONFIG_FILE"
}

cfg() {
  ensure_config
  jq -r --arg k "$1" --argjson d "$DEFAULT_CONFIG" \
    'if (.[$k] == null) then ($d[$k] // "") else .[$k] end' "$CONFIG_FILE" 2>/dev/null ||
    jq -r --arg k "$1" '.[$k] // ""' <<<"$DEFAULT_CONFIG"
}

# Written in place, never through a temporary file and a rename: a rename swaps
# the inode and the shell loses the file watch it holds, so the service would
# keep running on a config that no longer exists.
cfg_write() {
  printf '%s\n' "$1" >"$CONFIG_FILE" || die "cannot write $CONFIG_FILE"
}

cfg_set() {
  ensure_config
  local key=$1 value=${2-} tmp pool_stale= dropped
  case $key in
    rotateMinutes)
      case $value in 0|5|15|30|60|180|360|1440) ;; *) die "rotateMinutes must be one of 0 5 15 30 60 180 360 1440, got: $value" ;; esac
      tmp=$(jq --argjson v "$value" '.rotateMinutes = $v' "$CONFIG_FILE") ;;
    keepLast)
      [[ $value =~ ^[0-9]{1,3}$ ]] || die "keepLast must be a number of images between 1 and 999, got: $value"
      ((value > 0)) || die "keepLast must be at least 1"
      tmp=$(jq --argjson v "$value" '.keepLast = $v' "$CONFIG_FILE") ;;
    expose)
      case $value in true|false) ;; *) die "expose must be true or false, got: $value" ;; esac
      tmp=$(jq --argjson v "$value" '.expose = $v' "$CONFIG_FILE") ;;
    favoritesOnly)
      case $value in true|false) ;; *) die "favoritesOnly must be true or false, got: $value" ;; esac
      tmp=$(jq --argjson v "$value" '.favoritesOnly = $v' "$CONFIG_FILE")
      pool_stale=1 ;;
    language)
      case $value in auto|en|zh|hi|es|fr|ar|pt|ru|ja|de|it|ko|tr) ;; *) die "language must be auto or one of en zh hi es fr ar pt ru ja de it ko tr, got: $value" ;; esac
      tmp=$(jq --arg v "$value" '.language = $v' "$CONFIG_FILE") ;;
    library)
      [[ -z $value || $value == /* ]] || die "library must be an absolute path or empty"
      tmp=$(jq --arg v "$value" '.library = $v' "$CONFIG_FILE") ;;
    sources.*)
      local src=${key#sources.}
      is_source "$src" || die "unknown source: $src"
      case $value in true|false) ;; *) die "source state must be true or false, got: $value" ;; esac
      tmp=$(jq --arg s "$src" --argjson v "$value" '.sources[$s] = $v' "$CONFIG_FILE")
      pool_stale=1 ;;
    themes.*)
      local theme=${key#themes.}
      is_theme "$theme" || die "unknown theme: $theme"
      case $value in true|false) ;; *) die "theme state must be true or false, got: $value" ;; esac
      tmp=$(jq --arg t "$theme" --argjson v "$value" '.themes[$t] = $v' "$CONFIG_FILE")
      pool_stale=1 ;;
    *) die "unknown config key: $key (try: $CONFIG_KEYS)" ;;
  esac
  [[ -n $tmp ]] || die "failed to update $key"
  cfg_write "$tmp"
  # Only the settings that decide what may be served invalidate the pool: an
  # interval or a language leaves it valid, because it holds nothing but files
  # that are still eligible.
  if [[ -n $pool_stale ]]; then
    dropped=$(stage_drop)
    ((dropped > 0)) && printf 'fresque: %s prepared image(s) dropped, they no longer match the filters\n' "$dropped" >&2
    stage_refill 2
  fi
}

# ---------------------------------------------------------------- themes

THEME_IDS="nature space architecture animals photos anime"

is_theme() { [[ " $THEME_IDS " == *" $1 "* ]]; }

# Where each theme is served from. Wikimedia categories are the community's own
# curated sets, and the Konachan tags are the ones that reliably hold 4K
# pictures rather than small illustrations.
CATALOG='{
  "nature":       { "wikimedia": "Featured_pictures_of_nature,Featured_pictures_of_landscapes,Quality_images_of_landscapes,Featured_pictures_of_plants,Quality_images_of_waterfalls" },
  "space":        { "wikimedia": "Featured_pictures_of_galaxies" },
  "architecture": { "wikimedia": "Featured_pictures_of_architecture,Quality_images_of_architecture" },
  "animals":      { "wikimedia": "Quality_images_of_birds,Quality_images_of_crustaceans,Quality_images_of_reptiles" },
  "photos":       { "wikimedia": "" },
  "anime":        { "konachan": "landscape,sky,night,city,water,cherry_blossoms,flowers,clouds,stars,sunset,winter,moon,building", "yandere": "landscape,flowers,city,stars" }
}'

SOURCE_IDS="bing wikimedia noirlab omarchy konachan yandere picsum"
# A weight is how often a source is asked, and it should follow what the source
# can add. A feed that publishes one picture a week (NOIRLab has 24 in all) is
# spent in a few days at a high weight, and then silent for a week, which reads
# as either a repeat or a disappearance. The sources with thousands of pictures
# carry the rotation.
SOURCE_WEIGHTS="bing=4 wikimedia=30 noirlab=5 omarchy=8 konachan=15 yandere=12 picsum=10"

is_source() { [[ " $SOURCE_IDS " == *" $1 "* ]]; }

source_label() {
  case $1 in
    bing)      printf 'Bing' ;;
    wikimedia) printf 'Wikimedia Commons' ;;
    noirlab)   printf 'NOIRLab' ;;
    omarchy)   printf 'Omarchy' ;;
    konachan)  printf 'Konachan' ;;
    yandere)   printf 'Yande.re' ;;
    picsum)    printf 'Unsplash' ;;
  esac
}

source_weight() { local kv; for kv in $SOURCE_WEIGHTS; do [[ ${kv%%=*} == "$1" ]] && { printf '%s' "${kv#*=}"; return; }; done; printf '0'; }

source_enabled() {
  local v
  v=$(jq -r --arg s "$1" '.sources[$s] // false' "$CONFIG_FILE" 2>/dev/null)
  [[ $v == "true" ]]
}

theme_enabled() {
  local v
  v=$(jq -r --arg t "$1" '.themes[$t] // false' "$CONFIG_FILE" 2>/dev/null)
  [[ $v == "true" ]]
}

catalog_get() { jq -r --arg t "$1" --arg s "$2" '.[$t][$s] // ""' <<<"$CATALOG" 2>/dev/null; }

# Community "quality" categories are curated by eye, and they still contain the
# occasional museum specimen, mural, map or diagram. One keyword list per theme
# removes the obvious non-photographs before anything is downloaded, which is
# cheaper than discovering them on the screen.
THEME_BLOCK='{
  "animals":      "museum fossil taxiderm specimen statue sculpture diorama mural illustration drawing painting sketch engraving",
  "space":        "illustration diagram drawing chart map graph",
  "architecture": "diagram plan map drawing painting sketch engraving illustration",
  "nature":       "diagram map chart graph illustration drawing sketch painting",
  "anime":        "",
  "photos":       ""
}'

theme_block() { jq -r --arg t "$1" '.[$t] // ""' <<<"$THEME_BLOCK" 2>/dev/null; }

# Which themes a source can serve. `any` marks a source that cannot be filtered
# at all: Bing is one picture chosen for the day by someone else, so it is only
# used when no theme filter is set, rather than being allowed to slip a
# landscape into a request for animals or space.
source_themes() {
  case $1 in
    bing)      printf 'photos' ;;
    wikimedia) printf 'nature space architecture animals' ;;
    noirlab)   printf 'space' ;;
    omarchy)   printf 'photos' ;;
    konachan)  printf 'anime' ;;
    yandere)   printf 'anime' ;;
    picsum)    printf 'photos' ;;
  esac
}

enabled_themes() {
  local t out=""
  for t in $THEME_IDS; do theme_enabled "$t" && out+="$t "; done
  printf '%s' "${out% }"
}

enabled_sources() {
  local s out=""
  for s in $SOURCE_IDS; do source_enabled "$s" && out+="$s "; done
  printf '%s' "${out% }"
}

# Filters restrict. With every theme switched off there is no restriction left,
# so everything is allowed rather than nothing: that is what turning the filters
# off means, and it removes a dead end where the plugin could only fail.
filter_active() {
  local on
  on=$(enabled_themes)
  [[ -n $on && $on != "$THEME_IDS" ]]
}

# A source is usable when it is switched on and at least one of the themes it
# can serve is on. This is the preference filter, and it runs before any
# request goes out rather than after a picture is already on screen.
source_matches_preferences() {
  local src=$1 t served
  served=$(source_themes "$src")
  # A source that cannot be filtered is only used when nothing is filtered.
  if [[ $served == "any" ]]; then
    ! filter_active
    return $?
  fi
  # Nothing filtered: every source is eligible.
  filter_active || return 0
  for t in $served; do
    theme_enabled "$t" && return 0
  done
  return 1
}

pick_source() {
  local total=0 src w pick
  for src in $SOURCE_IDS; do
    source_enabled "$src" || continue
    source_matches_preferences "$src" || continue
    w=$(source_weight "$src")
    total=$((total + w))
  done
  ((total > 0)) || return 1
  pick=$((RANDOM % total))
  for src in $SOURCE_IDS; do
    source_enabled "$src" || continue
    source_matches_preferences "$src" || continue
    w=$(source_weight "$src")
    if ((pick < w)); then printf '%s' "$src"; return 0; fi
    pick=$((pick - w))
  done
  return 1
}

# One theme the chosen source can serve, picked at random among the enabled
# ones, so a rotation with several themes on does not always query the same one.
pick_theme_for() {
  local src=$1 t options=() served
  served=$(source_themes "$src")
  [[ $served == "any" ]] && { printf '%s' "any"; return 0; }
  if filter_active; then
    for t in $served; do
      theme_enabled "$t" && options+=("$t")
    done
  else
    # Nothing filtered: any theme this source can serve is fair game.
    for t in $served; do options+=("$t"); done
  fi
  ((${#options[@]} > 0)) || { printf '%s' "photos"; return 0; }
  printf '%s' "${options[$((RANDOM % ${#options[@]}))]}"
}

# ---------------------------------------------------------------- screen

# The quality gate. A wallpaper has to be at least as large as the screen it
# will be cropped onto, and close enough to that screen's aspect ratio that the
# crop does not eat half the picture.
screen_geometry() {
  local wh
  wh=$(hyprctl monitors -j 2>/dev/null |
    jq -r 'if type=="array" and length>0 then ([.[]|select(.disabled!=true)]|sort_by(.width*.height)|last|"\(.width) \(.height)") else "" end' 2>/dev/null)
  [[ $wh =~ ^[0-9]+\ [0-9]+$ ]] || wh="1920 1080"
  printf '%s' "$wh"
}

# Shape of a picture that can fill a widescreen desktop without a destructive
# crop. Landscape, at least 5:4, at most 2.7:1. A portrait photograph of the
# same pixel count ends up as a band across the middle, and an extreme panorama
# loses its subject, so neither counts as a wallpaper worth serving here.
# Shape is not enough: a picture also has to be affordable. A 40000x20000 PNG
# is 3 GB once decoded, and no screen here is that big.
pixels_ok() {
  local w=$1 h=$2
  [[ $w =~ ^[0-9]+$ && $h =~ ^[0-9]+$ ]] || return 1
  ((w > 0 && h > 0)) || return 1
  ((w <= MAX_SIDE && h <= MAX_SIDE)) || return 1
  ((w * h <= MAX_PIXELS))
}

aspect_ok() {
  local w=$1 h=$2
  [[ $w =~ ^[0-9]+$ && $h =~ ^[0-9]+$ ]] || return 1
  awk -v a="$w" -v b="$h" 'BEGIN { if (b <= 0) exit 1; r = a / b; exit !(r >= 1.2 && r <= 2.7) }'
}

# ---------------------------------------------------------------- sources
#
# Every source normalizes to the same record shape, so nothing downstream has
# to know which API it came from:
#   { source, id, theme, full, alt, thumb, width, height, credit, link, license }

# Bing publishes the same picture at several sizes. UHD is 3840x2160 and is only
# generated for recent images, so the 1080p variant travels along as the
# fallback and the size gate rejects it when the screen is bigger.
# Bing publishes one photograph a day and only the last eight stay on offer, so
# this pool never grows the way the others do. An entry already served is the
# same photograph coming back, which is what it looked like. Only the ones never
# shown are offered, and nothing at all once all eight have been seen.
candidates_bing() {
  local rows
  rows=$(curl_json "https://www.bing.com/HPImageArchive.aspx?format=js&idx=0&n=8&mkt=en-US" |
    jq -c '[.images[]? | {
      source: "bing",
      id: (.startdate // .enddate),
      theme: "photos",
      full: ("https://www.bing.com" + .urlbase + "_UHD.jpg&pid=hp"),
      alt: ("https://www.bing.com" + (.url // "")),
      thumb: ("https://www.bing.com" + (.url // "")),
      width: 3840,
      height: 2160,
      credit: ((.title // "") + ", " + (.copyright // "")),
      link: "https://www.bing.com",
      license: "Bing, credited to its author"
    }]')
  [[ -n $rows && $rows != "null" ]] || { printf '[]'; return 0; }
  collect_unseen "$rows"
}

# Wikimedia Commons is where the best freely licensed photography lives. The
# 3840px thumbnail is fetched rather than the original, because originals are
# sometimes 60 MB TIFFs and this is a wallpaper, not an archive.
candidates_wikimedia() {
  local theme=$1 min_w=$2 min_h=$3 scaled=3840 pool cats cat page rows="[]"
  ((min_w > scaled)) && scaled=$min_w
  pool=$(catalog_get "$theme" wikimedia | tr ',' '\n' | grep -v '^$')
  [[ -n $pool ]] || { printf '[]'; return 0; }
  # Two categories per request rather than one. A theme is only a handful of
  # categories and a category is 20 to 50 files, so asking for two at a time is
  # what keeps a single-filter rotation from serving the same pictures again.
  cats=$(printf '%s\n' "$pool" | shuf -n 2)
  for cat in $cats; do
    [[ -n $cat ]] || continue
    page=$(curl_json "https://commons.wikimedia.org/w/api.php?action=query&format=json&generator=categorymembers&gcmtitle=Category:$(urlencode "$cat")&gcmtype=file&gcmlimit=$PAGE_SIZE&prop=imageinfo&iiprop=url%7Csize%7Cextmetadata&iiurlwidth=$scaled" |
      jq -c --argjson minw "$min_w" --argjson minh "$min_h" --arg theme "$theme" \
        '[.query.pages[]? | (.imageinfo[0] // {}) as $ii | {
          source: "wikimedia",
          id: ((.title // "") | sub("^File:"; "")),
          theme: $theme,
          full: ($ii.thumburl // $ii.url),
          alt: ($ii.url // ""),
          thumb: ($ii.thumburl // $ii.url),
          width: (($ii.width // 0) | try tonumber catch 0),
          height: (($ii.height // 0) | try tonumber catch 0),
          credit: (((($ii.extmetadata.Artist.value // "")) | gsub("<[^>]*>"; "") | gsub("\\s+"; " ")) | ltrimstr(" ") | rtrimstr(" ")),
          link: ("https://commons.wikimedia.org/wiki/" + ((.title // "") | @uri)),
          license: ($ii.extmetadata.LicenseShortName.value // "Free license")
        } | select(.width >= $minw and .height >= $minh)]' 2>/dev/null)
    [[ -n $page && $page != "null" ]] && rows=$(jq -c --argjson b "$page" '. + $b' <<<"$rows")
  done
  printf '%s' "$rows"
}

# Konachan and Yande.re run the same image board software and both are built
# around wallpapers: they are where anime art at 4K and beyond lives, tagged by
# scene, with the artist and the original page on every post. The safe rating
# and the minimum size are part of the query rather than a promise, so a request
# is spent on something that can actually fill the screen.
candidates_booru() {
  local host=$1 name=$2 theme=$3 min_w=$4 min_h=$5 tag="" url page limit=30
  # A tag most of the time gives scene variety (city, night, water), and no tag
  # the rest of the time opens the whole safe 4K library of the board. Together
  # with a random page this is what keeps a single-filter rotation from serving
  # the same pictures twice.
  page=$((RANDOM % 30 + 1))
  if ((RANDOM % 10 < 7)); then
    tag=$(catalog_get "$theme" "$name" | tr ',' '\n' | grep -v '^$' | shuf -n 1)
  fi
  url="https://$host/post.json?tags=rating%3Asafe+width%3A%3E%3D${min_w}+height%3A%3E%3D${min_h}"
  [[ -n $tag ]] && url+="+$(urlencode "$tag")"
  url+="&limit=$limit&page=$page"
  curl_json "$url" |
    jq -c --arg src "$name" --arg host "$host" --arg theme "$theme" '[.[]? | select(.file_url != null and .id != null) | {
      source: $src,
      id: (.id | tostring),
      theme: $theme,
      full: (.jpeg_url // .file_url),
      alt: (.file_url // ""),
      thumb: (.preview_url // .sample_url),
      width: ((.width // 0) | try tonumber catch 0 | if . < 0 then 0 else . end),
      height: ((.height // 0) | try tonumber catch 0 | if . < 0 then 0 else . end),
      credit: (if (.author // "") == "tagme" then "" else (.author // "") end),
      link: ("https://" + $host + "/post/show/" + (.id | tostring)),
      license: "Fan art, credited to its artist"
    }]'
}

candidates_konachan() { candidates_booru konachan.net konachan "$@"; }

candidates_yandere() { candidates_booru yande.re yandere "$@"; }

# NOIRLab publishes an image of the week, and its archive keeps a full size
# rendering of each one. Curated sky photography: the Milky Way over an
# observatory, a comet, an eclipse, and the occasional galaxy.
astro_feed_items() {
  curl_json "$1" | tr -d '\n' | sed 's/<item>/\n<item>/g' | sed -n '2,$p' |
    sed 's/&amp;/\&/g' |
    sed -n 's|.*<title>\([^<]*\)</title><link>[^<]*/images/\([a-z0-9]*\)/</link>.*|\2\t\1|p'
}

# A diagram of an instrument or an artist's impression is not a wallpaper, and
# the releases mix them in with the photographs. The title says which is which,
# so the graphics are dropped before anything is downloaded.
GRAPHIC_TITLES='diagram|illustration|artist|infographic|chart|spectrum|schematic|comparison|composite|model|annotated|labelled|labeled|crop|cutout|collage|location of|close-up|panorama|mosaic'

candidates_noirlab() {
  local theme=$1 min_w=$2 min_h=$3 rows="[]" item spec
  local full size row kept dims w h
  for spec in "https://noirlab.edu/public/images/iotw/feed/ https://storage.noirlab.edu/media/archives/images NOIRLab Image of the Week NOIRLab/NSF/AURA, CC BY 4.0"; do
    set -- $spec
    local url=$1 cdn=$2 credit=$3 license=$4 page="https://noirlab.edu/public/images"
    item=$(astro_feed_items "$url" | jq -R -s --arg cdn "$cdn" --arg credit "$credit" \
      --arg page "$page" --arg theme "$theme" --arg graphic "$GRAPHIC_TITLES" --arg license "$license" '
      split("\n") | map(select(length > 0) | split("\t")) | map(select(length >= 2)) | map({
        source: "noirlab",
        id: .[0],
        title: .[1],
        theme: $theme,
        full: ($cdn + "/large/" + .[0] + ".jpg"),
        alt: ($cdn + "/screen/" + .[0] + ".jpg"),
        thumb: ($cdn + "/screen/" + .[0] + ".jpg"),
        width: 0,
        height: 0,
        credit: (.[1] + ", " + $credit),
        link: ($page + "/" + .[0] + "/"),
        license: $license
      }) | map(select(((.title // "") | test($graphic; "i")) | not))' 2>/dev/null)
    [[ -n $item && $item != "null" ]] || continue
    # The full size renderings run from 2 MP to 140 MP, and the feed says nothing
    # about which is which. Measuring the header of each candidate costs 64 KB
    # and settles both the shape and the weight, so nothing huge is downloaded
    # only to be refused.
    kept="[]"
    for row in $(jq -r '.[] | @base64' <<<"$item" | shuf -n 12); do
      row=$(printf '%s' "$row" | base64 -d 2>/dev/null)
      [[ -n $row ]] || continue
      full=$(jq -r '.full' <<<"$row")
      dims=$(remote_probe "$full") || continue
      w=$(dimension "$(printf '%s' "$dims" | cut -d' ' -f1)") || continue
      h=$(dimension "$(printf '%s' "$dims" | cut -d' ' -f2)") || continue
      size=$(dimension "$(printf '%s' "$dims" | cut -d' ' -f3)") || size=0
      ((w >= min_w && h >= min_h)) || continue
      pixels_ok "$w" "$h" || continue
      aspect_ok "$w" "$h" || continue
      # A stitched panorama can be 140 MB and there is no point downloading one
      # wallpaper rotation.
      ((size > 8000000)) && continue
      row=$(jq -c --argjson w "$w" --argjson h "$h" '.width = $w | .height = $h' <<<"$row")
      kept=$(jq -c --argjson r "$row" '. + [$r]' <<<"$kept")
    done
    [[ -n $kept && $kept != "null" ]] && rows=$(jq -c --argjson b "$kept" '. + $b' <<<"$rows")
  done
  printf '%s' "$rows"
}
# Picsum serves Unsplash photographs through its own API with nothing to sign
# up for. The picture is requested at the screen's own size, so the server does
# the crop instead of the renderer and nothing is upscaled.
# The wallpapers that come with Omarchy itself. They are already on the disk,
# so this source costs no request, no download and no copy: the picture is put
# on screen where it lies. The directory Fresque writes its own links into is
# left out, otherwise the source would end up serving its own choices back.
omarchy_wallpaper_dirs() {
  local d
  for d in /usr/share/omarchy/themes/*/backgrounds "$HOME/.config/omarchy/themes"/*/backgrounds; do
    [[ -d $d ]] && printf '%s\n' "$d"
  done
}

candidates_omarchy() {
  local theme=$1 min_w=$2 min_h=$3 out="[]" dir f label id dims w h
  while IFS= read -r dir; do
    label=$(basename "$(dirname "$dir")")
    while IFS= read -r f; do
      [[ -f $f ]] || continue
      dims=$(image_dimensions "$f") || continue
      w=$(dimension "$(printf '%s' "$dims" | cut -d' ' -f1)") || continue
      h=$(dimension "$(printf '%s' "$dims" | cut -d' ' -f2)") || continue
      ((w >= min_w && h >= min_h)) || continue
      pixels_ok "$w" "$h" || continue
      aspect_ok "$w" "$h" || continue
      id="$(printf '%s' "$label")-$(basename "$f" | sed 's/\.[a-zA-Z]*$//')"
      out=$(jq -c --arg id "$id" --arg theme "$theme" --arg path "$f" --arg label "$label" \
        --argjson w "$w" --argjson h "$h" \
        '. + [{source: "omarchy", id: $id, theme: $theme, local: $path, full: $path, alt: "", thumb: $path,
               width: $w, height: $h, credit: ("Omarchy, " + $label + " theme"),
               link: "https://omarchy.org/", license: "Shipped with Omarchy"}]' <<<"$out")
    done < <(find "$dir" -maxdepth 1 -type f \( -name '*.jpg' -o -name '*.jpeg' -o -name '*.png' -o -name '*.webp' \) 2>/dev/null)
  done < <(omarchy_wallpaper_dirs)
  printf '%s' "$out"
}

candidates_picsum() {
  local min_w=$1 min_h=$2 page
  page=$((RANDOM % 12 + 1))
  curl_json "https://picsum.photos/v2/list?page=$page&limit=40" |
    jq -c --argjson minw "$min_w" --argjson minh "$min_h" \
      '[.[]? | select(.width >= $minw and .height >= $minh) | {
        source: "picsum",
        id: (.id // ""),
        theme: "photos",
        full: ("https://picsum.photos/id/" + (.id // "") + "/" + ($minw | tostring) + "/" + ($minh | tostring)),
        alt: (.download_url // ""),
        thumb: ("https://picsum.photos/id/" + (.id // "") + "/800/450"),
        width: $minw,
        height: $minh,
        credit: (.author // ""),
        link: (.url // "https://picsum.photos"),
        license: "Unsplash License"
      }]'
}

fetch_candidates() {
  local src=$1 theme=$2 min_w=$3 min_h=$4 rows row w h out="[]"
  # Whatever asked for a size, only digits reach the comparisons below.
  min_w=$(dimension "$min_w") || min_w=1920
  min_h=$(dimension "$min_h") || min_h=1080
  case $src in
    bing)      rows=$(candidates_bing) ;;
    wikimedia) rows=$(candidates_wikimedia "$theme" "$min_w" "$min_h") ;;
    noirlab)   rows=$(candidates_noirlab "$theme" "$min_w" "$min_h") ;;
    konachan)  rows=$(candidates_konachan "$theme" "$min_w" "$min_h") ;;
    yandere)   rows=$(candidates_yandere "$theme" "$min_w" "$min_h") ;;
    omarchy)   rows=$(candidates_omarchy "$theme" "$min_w" "$min_h") ;;
    picsum)    rows=$(candidates_picsum "$min_w" "$min_h") ;;
    *)         printf '[]'; return 0 ;;
  esac
  [[ -n $rows && $rows != "null" ]] || { printf '[]'; return 0; }
  # Size and shape are checked on the metadata a source declares.
  local block pat
  block=$(theme_block "$theme")
  while IFS= read -r row; do
    w=$(dimension "$(jq -r '.width // 0' <<<"$row")") || w=0
    h=$(dimension "$(jq -r '.height // 0' <<<"$row")") || h=0
    # The row is rebuilt from those two numbers, so nothing a source sent can
    # travel on inside the candidate and reach an arithmetic context later.
    row=$(jq -c --argjson w "$w" --argjson h "$h" '.width = $w | .height = $h' <<<"$row") || continue
    if [[ $w == "0" || $h == "0" ]]; then
      out=$(jq -c --argjson r "$row" '. + [$r]' <<<"$out")
      continue
    fi
    ((w >= min_w && h >= min_h)) || continue
    pixels_ok "$w" "$h" || continue
    aspect_ok "$w" "$h" || continue
    out=$(jq -c --argjson r "$row" '. + [$r]' <<<"$out")
  done < <(jq -c '.[]' <<<"$rows" 2>/dev/null)
  # Then the keywords, on every source including the ones that declare no size.
  if [[ -n $block ]]; then
    pat=$(printf '%s' "$block" | tr ' ' '|')
    out=$(jq -c --arg pat "$pat" '[.[] | select((.id | ascii_downcase | test($pat)) | not)]' <<<"$out" 2>/dev/null)
  fi
  printf '%s' "$out"
}

# ---------------------------------------------------------------- library
#
# The library directory holds wallpapers and nothing else. Every piece of
# metadata lives in the state directory: a folder of images stays a folder of
# images, which is what people expect when they open it.

# Anything written down about a picture goes through this: markup delimiters and
# control characters never reach the state files, so no interface can be handed a
# string that a renderer would read as a document. Tabs and newlines are folded
# as well, because a tab is the column separator here.
plain_text() {
  printf '%s' "${1-}" | tr -d '<>' | tr -d '[:cntrl:]' | tr -s ' ' |
    sed -e 's/^ *//' -e 's/ *$//' | cut -c1-300
}

meta_put() {
  local file=$1 source=$2 id=$3 credit=$4 link=$5 license=$6 theme=$7 base
  ensure_dir "$STATE_DIR"
  base=$(basename "$file")
  meta_forget "$base"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$base" "$source" "$id" \
    "$(plain_text "$credit")" "$(plain_text "$link")" "$(plain_text "$license")" "$theme" >>"$INDEX_FILE"
}

meta_forget() {
  local base=$1
  [[ -f $INDEX_FILE ]] || return 0
  awk -F'\t' -v f="$base" '$1!=f' "$INDEX_FILE" >"$INDEX_FILE.new" 2>/dev/null &&
    mv -f "$INDEX_FILE.new" "$INDEX_FILE"
}

meta_get() {
  local base=$1 field=$2
  [[ -f $INDEX_FILE ]] || return 1
  awk -F'\t' -v f="$base" -v n="$field" '$1==f { print $n }' "$INDEX_FILE" | tail -1
}

list_library() {
  local dir=$1
  [[ -d $dir ]] || return 0
  find "$dir" -maxdepth 1 -type f -name "$FILE_PREFIX*" -printf '%T@\t%p\n' 2>/dev/null |
    sort -rn | cut -f2-
}

count_dir() {
  local dir=$1
  [[ -d $dir ]] || { printf '0'; return 0; }
  find "$dir" -maxdepth 1 -type f -name "$FILE_PREFIX*" 2>/dev/null | wc -l | tr -d ' '
}

count_library() { count_dir "$1"; }

# Keeps the newest N images, so the folder cannot grow without end. The one on
# screen is never deleted, and the theme folder is trimmed to the same set.
cmd_prune() {
  local keep=$1 dir=$2 current victim
  [[ $keep =~ ^[0-9]+$ ]] || keep=30
  ((keep > 0)) || return 0
  [[ -d $dir ]] || return 0
  current=$(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null)

  while (($(count_library "$dir") > keep)); do
    victim=$(list_library "$dir" | grep -v "^$current$" | grep -vFf "$STAGED_FILE" 2>/dev/null | tail -1)
    [[ -n $victim ]] || victim=$(list_library "$dir" | grep -v "^$current$" | tail -1)
    [[ -n $victim ]] || break
    # A file waiting in the staged pool is never pruned: it is about to be
    # shown, and the next rotation would have to download it again.
    is_staged "$victim" && break
    # A file that is also a favorite keeps its row in the index: the favorite
    # still needs its credits after the library copy is gone.
    if [[ ! -e "$(favorites_dir)/$(basename "$victim")" ]]; then
      meta_forget "$(basename "$victim")"
    fi
    rm -f "$victim"
  done
  return 0
}

# Drops the theme-folder entries whose image is gone, then keeps the newest N,
# so the native picker never lists a wallpaper that no longer exists.
prune_theme_dir() {
  local dir=$1 keep=$2 files=() i
  [[ -d $dir ]] || return 0
  while IFS= read -r f; do
    [[ -e $f ]] || { rm -f "$f"; continue; }
    files+=("$f")
  done < <(find "$dir" -maxdepth 1 -name "$FILE_PREFIX*" -printf '%T@\t%p\n' 2>/dev/null | sort -rn | cut -f2-)

  for ((i = keep; i < ${#files[@]}; i++)); do
    rm -f "${files[$i]}"
  done
}

expose_in_theme() {
  local path=$1 dir
  [[ ${FRESQUE_DRY_RUN:-0} == 1 ]] && return 0
  [[ $(cfg expose) == "true" ]] || return 0
  dir=$(theme_dir)
  ensure_dir "$dir" || return 0
  ln -f "$path" "$dir/$(basename "$path")" 2>/dev/null ||
    ln -sf "$path" "$dir/$(basename "$path")" 2>/dev/null || true
}

set_background() {
  local path=$1
  # Test seam: FRESQUE_DRY_RUN=1 exercises the whole fetch, verify and prune
  # path without touching the desktop background or the theme folder.
  [[ ${FRESQUE_DRY_RUN:-0} == 1 ]] && return 0
  omarchy theme bg set "$path" >/dev/null 2>&1 && return 0
  omarchy-theme-bg-set "$path" >/dev/null 2>&1 && return 0
  die "failed to set the background"
}

# ---------------------------------------------------------------- history

mark_seen() {
  ensure_dir "$STATE_DIR"
  printf '%s\t%s\n' "$1" "$2" >>"$SEEN_FILE" 2>/dev/null
  if [[ -f $SEEN_FILE ]] && [[ $(wc -l <"$SEEN_FILE") -gt $SEEN_KEEP ]]; then
    tail -n "$SEEN_KEEP" "$SEEN_FILE" >"$SEEN_FILE.new" && mv -f "$SEEN_FILE.new" "$SEEN_FILE"
  fi
}

was_seen() { [[ -f $SEEN_FILE ]] && grep -qxF "$1	$2" "$SEEN_FILE"; }

is_blocked() { [[ -f $BLOCKED_FILE ]] && grep -qxF "$1	$2" "$BLOCKED_FILE"; }

block_item() {
  ensure_dir "$STATE_DIR"
  is_blocked "$1" "$2" || printf '%s\t%s\n' "$1" "$2" >>"$BLOCKED_FILE"
}

# ---------------------------------------------------------------- applying

choose_candidate() {
  local rows=$1 src id fresh unseen row
  fresh=$(jq -c '[.[] | select(.full != "" and .id != "")]' <<<"$rows" 2>/dev/null)
  [[ $(jq 'length' <<<"${fresh:-[]}" 2>/dev/null) -gt 0 ]] || return 1

  # Everything in this pool has been seen already. Serving it again is how the
  # same photograph came back; another source will do better, and the caller
  # moves on to one.
  unseen=$(collect_unseen "$fresh")
  [[ $(jq 'length' <<<"$unseen" 2>/dev/null) -gt 0 ]] || return 1
  jq -c --argjson n "$(jq 'length' <<<"$unseen")" '.[ (now * 1000 | floor) % $n ]' <<<"$unseen"
}

collect_unseen() {
  local rows=$1 ignore_seen=${2:-0} row src id out="[]"
  while IFS= read -r row; do
    src=$(jq -r '.source' <<<"$row"); id=$(jq -r '.id' <<<"$row")
    is_blocked "$src" "$id" && continue
    if ((ignore_seen == 0)); then
      was_seen "$src" "$id" && continue
    fi
    out=$(jq -c --argjson r "$row" '. + [$r]' <<<"$out")
  done < <(jq -c '.[]' <<<"$rows" 2>/dev/null)
  printf '%s' "$out"
}

write_current() {
  local photo=$1 path=$2
  ensure_dir "$STATE_DIR"
  jq -cn --argjson p "$photo" --arg path "$path" --argjson at "$(now_ms)" '{
    path: $path,
    source: ($p.source // ""),
    id: ($p.id // ""),
    theme: ($p.theme // ""),
    credit: ((($p.credit // "") | gsub("[<>]"; "") | gsub("[\u0000-\u001f\u007f]"; " ")
              | gsub("\\s+"; " ") | sub("^ +"; "") | sub(" +$"; ""))),
    link: (($p.link // "") | gsub("[<>]"; "") | gsub("[\u0000-\u001f\u007f]"; " ")),
    license: (($p.license // "") | gsub("[<>]"; "") | gsub("[\u0000-\u001f\u007f]"; " ")),
    width: ($p.width // 0),
    height: ($p.height // 0),
    appliedAt: $at,
    retryAt: 0,
    # Only this function writes an entry for a picture that has just been shaped
    # or produced, and the interfaces read this flag before opening the file.
    shaped: true
  }' >"$CURRENT_FILE"
}

cur_json() { [[ -s $CURRENT_FILE ]] && cat "$CURRENT_FILE" || printf '{}'; }

# After a failure the next attempt is due in five minutes, so an offline laptop
# retries soon instead of waiting out a whole day.
note_failure() {
  ensure_dir "$STATE_DIR"
  local at cur
  at=$(now_ms)
  cur=$(cat "$CURRENT_FILE" 2>/dev/null)
  if [[ -n $cur ]]; then
    jq -c --argjson r "$((at + RETRY_MS))" '.retryAt = $r' <<<"$cur" >"$CURRENT_FILE"
  else
    jq -cn --argjson r "$((at + RETRY_MS))" '{retryAt: $r, appliedAt: 0}' >"$CURRENT_FILE"
  fi
}

# Downloads one candidate into the library and prints its path. Every gate runs
# here, so whatever comes back is a usable wallpaper. Nothing is put on screen,
# which is what allows the next one to be fetched in advance.
# Whatever a source served is rewritten before the shell is ever asked to show
# it. A renderer decodes at the file's full size and keeps its text and colour
# chunks in memory while it does, so a small PNG carrying a large compressed
# profile, or a canvas far larger than any screen, is a way to take the shell
# down without ever exceeding a download limit. Reading and writing the picture
# here, in a short lived tool with its own memory ceiling, leaves a plain JPEG
# holding nothing but pixels, at twice the screen at most.
normalise_image() {
  local src=$1 dest=$2 cap_w=$3 cap_h=$4
  [[ -s $src ]] || return 1
  if command -v magick >/dev/null 2>&1; then
    # The ceilings are for the tool, not for the picture: a hostile file makes
    # magick fail, which costs one candidate, instead of the shell.
    magick -limit memory 512MiB -limit map 1GiB -limit disk 2GiB \
      "$src" -strip -resize "${cap_w}x${cap_h}>" -quality 88 "$dest" 2>/dev/null || return 1
    verify_image "$dest" || return 1
    return 0
  fi
  if command -v vips >/dev/null 2>&1; then
    vips copy "$src" "$dest" 2>/dev/null || return 1
    verify_image "$dest" || return 1
    return 0
  fi
  # Nothing installed to re-encode with: a JPEG is taken as it is, because a
  # JPEG cannot describe a canvas or carry text the way a PNG can, and anything
  # else is refused rather than handed over.
  case $src in *.jpg|*.jpeg|*.JPG|*.JPEG) mv -f "$src" "$dest" ;; *) return 1 ;; esac
  verify_image "$dest" || return 1
  return 0
}

fetch_photo() {
  local photo=$1 min_w=$2 min_h=$3
  local id src theme slug full alt dir dest tmp dims w h url cap_w cap_h
  # What the picture is kept at: twice the screen it has to fill, never above
  # the ceiling. A 46 MP file and a 15 MP one look the same on a 2560x1440
  # screen, and only one of them costs the shell 200 MB to hold.
  cap_w=$((min_w * KEEP_SCALE)); cap_h=$((min_h * KEEP_SCALE))
  ((cap_w > MAX_SIDE)) && cap_w=$MAX_SIDE
  ((cap_h > MAX_SIDE)) && cap_h=$MAX_SIDE
  id=$(jq -r '.id // ""' <<<"$photo")
  src=$(jq -r '.source // ""' <<<"$photo")
  theme=$(jq -r '.theme // ""' <<<"$photo")
  # A wallpaper that is already on this machine is used where it lies: copying
  # a 5 MB file to rotate between two folders is waste, and the theme folders
  # ship with the system.
  local local_path
  local_path=$(jq -r '.local // ""' <<<"$photo")
  if [[ -n $local_path ]]; then
    [[ -f $local_path ]] || return 1
    dims=$(image_dimensions "$local_path") || return 1
    w=$(dimension "$(printf '%s' "$dims" | cut -d' ' -f1)") || return 1
    h=$(dimension "$(printf '%s' "$dims" | cut -d' ' -f2)") || return 1
    ((w >= min_w && h >= min_h)) || return 1
    pixels_ok "$w" "$h" || return 1
    aspect_ok "$w" "$h" || return 1
    meta_put "$local_path" "$src" "$id" "$(jq -r '.credit // ""' <<<"$photo")" \
      "$(jq -r '.link // ""' <<<"$photo")" "$(jq -r '.license // ""' <<<"$photo")" "$theme"
    mark_seen "$src" "$id"
    printf '%s\n' "$local_path"
    return 0
  fi
  full=$(jq -r '.full // ""' <<<"$photo")
  alt=$(jq -r '.alt // ""' <<<"$photo")
  [[ -n $id && -n $full ]] || return 1
  # Nothing but https ever reaches curl, whatever a source claims.
  case $full in https://*) ;; *) return 1 ;; esac
  case $alt in https://*|"") ;; *) alt="" ;; esac

  slug=$(slugify "$id")
  [[ -n $slug ]] || slug=$(printf '%s' "$id" | tr -cd 'a-z0-9')
  dir=$(library_dir)
  ensure_dir "$dir"
  dest="$dir/$FILE_PREFIX$src-$slug.jpg"

  if [[ ! -s $dest ]]; then
    for url in "$full" "$alt"; do
      [[ -n $url ]] || continue
      case $url in https://*) ;; *) continue ;; esac
      tmp=$(mktemp "$dir/.$FILE_PREFIX$src-$slug.XXXXXX") || return 1
      if ! curl_file "$url" "$tmp" || ! verify_image "$tmp"; then
        rm -f "$tmp"
        continue
      fi
      # The pipe stops at one byte above the ceiling: a file that got that far
      # came from a server that kept going, and it is thrown away rather than
      # decoded.
      if (( $(stat -c %s "$tmp" 2>/dev/null || echo 0) > MAX_IMAGE_BYTES )); then
        rm -f "$tmp"
        continue
      fi
      # Measured, not trusted: a source may promise 4K and deliver 1024 pixels,
      # and a wallpaper smaller than the screen is what this plugin exists to
      # avoid. The second URL of a candidate is often the untouched original,
      # bigger than the re-encoded one, so a candidate refused on size is
      # retried instead of thrown away.
      dims=$(image_dimensions "$tmp")
      if [[ -n $dims ]]; then
        w=$(dimension "${dims% *}") || w=0
        h=$(dimension "${dims##* }") || h=0
        if ((w < min_w || h < min_h)) || ! aspect_ok "$w" "$h" || ! pixels_ok "$w" "$h"; then
          rm -f "$tmp"
          continue
        fi
      fi
      # The file that enters the library is one we wrote, at our own size, with
      # the metadata of the download left behind in the tool that read it.
      if ! normalise_image "$tmp" "$dest" "$cap_w" "$cap_h"; then
        rm -f "$tmp"
        continue
      fi
      rm -f "$tmp"
      chmod 644 "$dest"
      dims=$(image_dimensions "$dest")
      if [[ -n $dims ]]; then
        w=$(dimension "${dims% *}") || w=0
        h=$(dimension "${dims##* }") || h=0
        if ((w > 0 && h > 0)); then
          photo=$(jq -c --argjson w "$w" --argjson h "$h" '.width = $w | .height = $h' <<<"$photo")
        fi
      fi
      break
    done
    [[ -s $dest ]] || { note_failure; return 1; }
  fi

  meta_put "$dest" "$src" "$id" "$(jq -r '.credit // ""' <<<"$photo")" \
    "$(jq -r '.link // ""' <<<"$photo")" "$(jq -r '.license // ""' <<<"$photo")" "$theme"
  mark_seen "$src" "$id"
  cmd_prune "$(cfg keepLast)" "$dir"
  printf '%s\n' "$dest"
  return 0
}

# Installs a candidate on screen: fetch it if it is not already on disk, then
# set it, expose it to the theme folder and record it as the current wallpaper.
apply_photo() {
  local photo=$1 min_w=$2 min_h=$3 path dims w h
  path=$(fetch_photo "$photo" "$min_w" "$min_h") || return 1
  [[ -n $path && -f $path ]] || return 1
  # The size shown in the panel is the size of the file that is on screen, not
  # the size the source advertised: the picture has been re-encoded and capped
  # since then.
  dims=$(image_dimensions "$path")
  if [[ -n $dims ]]; then
    w=$(dimension "${dims% *}") || w=0
    h=$(dimension "${dims##* }") || h=0
    if ((w > 0 && h > 0)); then
      photo=$(jq -c --argjson w "$w" --argjson h "$h" '.width = $w | .height = $h' <<<"$photo")
    fi
  fi
  set_background "$path"
  expose_in_theme "$path"
  write_current "$photo" "$path"
  prune_theme_dir "$(theme_dir)" "$(cfg keepLast)"
  printf '%s\n' "$path"
  return 0
}

# The staged pool: a few wallpapers downloaded ahead of time. Applying one of
# them needs no network at all, which is what makes asking for the next
# wallpaper feel immediate.
stage_list() { [[ -f $STAGED_FILE ]] && cat "$STAGED_FILE" || true; }

stage_count() {
  local n=0 f
  while IFS= read -r f; do [[ -n $f && -f $f ]] && n=$((n + 1)); done < <(stage_list)
  printf '%s' "$n"
}

stage_add() {
  local path=$1
  [[ -n $path && -f $path ]] || return 1
  ensure_dir "$STATE_DIR"
  if [[ -f $STAGED_FILE ]] && grep -qxF "$path" "$STAGED_FILE"; then return 0; fi
  printf '%s\n' "$path" >>"$STAGED_FILE"
  return 0
}

# Takes one ready file out of the pool and rewrites the list without it.
# The ready list holds files, not decisions: whatever filled it, what goes on
# screen has to match the filters as they are now. A picture prepared before a
# filter changed, or by an older version of the plugin, is refused here rather
# than shown under a theme it does not belong to.
stage_eligible() {
  local path=$1 base src theme
  [[ -n $path && -f $path ]] || return 1
  base=$(basename "$path")
  src=$(meta_get "$base" 2)
  if [[ -z $src ]]; then
    src=$(printf '%s' "$base" | sed -n "s/^$FILE_PREFIX\([a-z]*\)-.*/\1/p")
  fi
  [[ -n $src ]] || return 1
  source_enabled "$src" || return 1
  filter_active || return 0
  theme=$(meta_get "$base" 7)
  [[ -n $theme && $theme != any && $theme != null ]] || return 0
  theme_enabled "$theme"
}

stage_pop() {
  local f found=""
  [[ -f $STAGED_FILE ]] || return 1
  while IFS= read -r f; do
    [[ -n $f && -f $f ]] || continue
    if [[ -z $found ]]; then
      found=$f
      continue
    fi
    printf '%s\n' "$f"
  done < <(cat "$STAGED_FILE") >"$STAGED_FILE.new"
  mv -f "$STAGED_FILE.new" "$STAGED_FILE" 2>/dev/null
  [[ -n $found ]] || return 1
  printf '%s' "$found"
  return 0
}

is_staged() {
  [[ -f $STAGED_FILE ]] && grep -qxF "$1" "$STAGED_FILE"
}

# A pool filled under other filters is worse than an empty one: the next click
# would serve a picture the user has just excluded, and the panel would show a
# theme the image does not belong to. The files stay in the library where the
# usual cap recycles them, only the ready list is emptied, and a refill starts
# in the background under the new filters.
stage_drop() {
  [[ -f $STAGED_FILE ]] || return 0
  local n
  # grep -c prints 0 and fails on an empty file, so the failure is swallowed
  # rather than replaced by a second count.
  n=$(grep -c . "$STAGED_FILE" 2>/dev/null || true)
  n=${n:-0}
  : >"$STAGED_FILE"
  printf '%s' "$n"
}

# Refills the pool in the background. Detached on purpose: the click that
# triggered it must not wait for the download.
stage_refill() {
  local want=${1:-2}
  [[ $(cfg favoritesOnly) == "true" ]] && return 0
  [[ -n $(enabled_sources) ]] || return 0
  ensure_dir "$STATE_DIR"
  setsid "$SELF" prefetch "$want" </dev/null >/dev/null 2>&1 &
  return 0
}

cmd_next() {
  ensure_config
  local wh min_w min_h attempt src theme rows pick failed=" " rc=1 enabled staged

  # Favorites only: the rotation goes local, and it keeps working with no
  # network at all.
  if [[ $(cfg favoritesOnly) == "true" ]]; then
    cmd_next_favorite && return 0
    die "no favorite is available yet"
  fi

  wh=$(screen_geometry)
  min_w=$(dimension "${wh% *}") || min_w=1920
  min_h=$(dimension "${wh##* }") || min_h=1080

  # A wallpaper fetched in advance is already on disk, so putting it on screen
  # costs nothing. The pool is refilled behind the scenes afterwards.
  staged=$(stage_pop)
  while [[ -n $staged ]] && ! stage_eligible "$staged"; do staged=$(stage_pop); done
  if [[ -n $staged ]] && apply_local "$staged"; then
    stage_refill 2
    return 0
  fi

  enabled=$(enabled_sources)
  [[ -n $enabled ]] || die "every source is switched off"

  for attempt in 1 2 3 4 5 6; do
    src=$(pick_source) || break
    [[ $failed == *" $src "* ]] && continue
    theme=$(pick_theme_for "$src")
    rows=$(fetch_candidates "$src" "$theme" "$min_w" "$min_h" 2>/dev/null)
    pick=""
    [[ -n $rows && $rows != "null" ]] && pick=$(choose_candidate "$rows" 2>/dev/null)
    if [[ -n $pick && $pick != "null" ]] && apply_photo "$pick" "$min_w" "$min_h"; then
      rc=0
      break
    fi
    failed+="$src "
  done

  if ((rc != 0)); then
    # Offline, or every source down. A favorite already on disk is a better
    # answer than leaving the same picture up and calling it a failure.
    cmd_next_favorite && return 0
    note_failure
    die "no source could provide a wallpaper right now"
  fi
  # Prepare the next one while this one is on screen.
  stage_refill 2
  return 0
}

# Downloads a few wallpapers in advance, so asking for the next one is instant.
# Guarded by a lock: several triggers, from the panel, the service and the bar
# pill, never pile up on the same source.
cmd_prefetch() {
  ensure_config
  local want=${1:-2} wh min_w min_h src theme rows pick path count attempts=0
  ensure_dir "$STATE_DIR"
  exec 9>"$STATE_DIR/prefetch.lock" 2>/dev/null || return 0
  flock -n 9 || return 0

  count=$(stage_count)
  want=$((count + want))
  ((want > STAGE_MAX)) && want=$STAGE_MAX
  ((count < want)) || return 0
  [[ $(cfg favoritesOnly) == "true" ]] && return 0
  [[ -n $(enabled_sources) ]] || return 0

  wh=$(screen_geometry)
  min_w=$(dimension "${wh% *}") || min_w=1920
  min_h=$(dimension "${wh##* }") || min_h=1080
  while (($(stage_count) < want)) && ((attempts < 4)); do
    attempts=$((attempts + 1))
    src=$(pick_source) || break
    theme=$(pick_theme_for "$src")
    rows=$(fetch_candidates "$src" "$theme" "$min_w" "$min_h" 2>/dev/null)
    [[ -n $rows && $rows != "null" ]] || continue
    pick=$(choose_candidate "$rows" 2>/dev/null) || continue
    [[ -n $pick && $pick != "null" ]] || continue
    path=$(fetch_photo "$pick" "$min_w" "$min_h" 2>/dev/null) || continue
    stage_add "$path"
  done
  return 0
}

# Serves one of the favorites, at random, skipping the one on screen and
# anything the user blocked.
cmd_next_favorite() {
  local dir current f src id theme files=() candidates=() n filtered=0 t hit
  dir=$(favorites_dir)
  [[ -d $dir ]] || return 1
  current=$(jq -r '.path // ""' <<<"$(cur_json)")
  while IFS= read -r f; do
    files+=("$f")
  done < <(find "$dir" -maxdepth 1 -type f -name "$FILE_PREFIX*" 2>/dev/null | sort)
  ((${#files[@]} > 0)) || return 1

  # A favorite is served as a last resort, but never against the filter: with
  # the space theme alone, an anime favorite is a different picture from the one
  # the panel promises, so it stays out and the failure is reported instead.
  for f in "${files[@]}"; do
    [[ $f == "$current" ]] && continue
    src=$(meta_get "$(basename "$f")" 2)
    id=$(meta_get "$(basename "$f")" 3)
    [[ -n $src && -n $id ]] && is_blocked "$src" "$id" && continue
    if filter_active; then
      theme=$(meta_get "$(basename "$f")" 7)
      # A favorite added before its source declared its themes carries no
      # usable theme, so the source decides which themes it belongs to.
      if [[ -z $theme || $theme == any || $theme == null ]]; then
        theme=$(source_themes "$src")
      fi
      hit=
      for t in $theme; do
        theme_enabled "$t" && { hit=1; break; }
      done
      [[ -n $hit ]] || continue
      filtered=1
    fi
    candidates+=("$f")
  done
  # Nothing matched the filter: rather than break it, the caller is told there
  # is nothing to serve. The last-resort fallback is only for an unfiltered
  # rotation, where any favorite is a fair answer.
  if ((${#candidates[@]} == 0)); then
    filter_active && return 1
    candidates=("${files[@]}")
  fi
  n=$((RANDOM % ${#candidates[@]}))
  apply_local "${candidates[$n]}"
}

# Puts a picture that is already on disk on screen. Credits come from the index
# when the row is there, so a favorite keeps its author and licence.
# One picture, made fit for the shell: a JPEG, at most twice the screen, nothing
# but pixels. A file can arrive here from the pool or from the favorites with a
# shape an older version accepted, PNG text chunks and all, and the shell is
# about to decode it. Those are rewritten on the spot, once. A wallpaper that
# belongs to the system is applied where it lies, as it always was.
ensure_shaped() {
  local path=$1 dims w h needs=0 wh minw minh cap_w cap_h base clean fav lib
  lib=$(library_dir); fav=$(favorites_dir)
  [[ -f $path ]] || return 1
  [[ $path == "$lib"/* || $path == "$fav"/* ]] || { printf '%s' "$path"; return 0; }

  dims=$(image_dimensions "$path" 2>/dev/null) || dims=
  if [[ -n $dims ]]; then
    w=$(dimension "${dims% *}") || w=0
    h=$(dimension "${dims##* }") || h=0
  else
    w=0; h=0
  fi
  # A name is not a format: the published version stored what the server sent
  # under the URL's suffix, so a PNG can sit behind a .jpg name.
  is_jpeg_file "$path" || needs=1
  ((w > 0 && h > 0)) || needs=1
  if ((w > 0 && h > 0)) && ! pixels_ok "$w" "$h"; then needs=1; fi
  if ((needs == 0)); then printf '%s' "$path"; return 0; fi

  wh=$(screen_geometry)
  minw=$(dimension "${wh% *}") || minw=1920
  minh=$(dimension "${wh##* }") || minh=1080
  cap_w=$((minw * KEEP_SCALE)); cap_h=$((minh * KEEP_SCALE))
  ((cap_w > MAX_SIDE)) && cap_w=$MAX_SIDE
  ((cap_h > MAX_SIDE)) && cap_h=$MAX_SIDE

  base=$(basename "$path"); base=${base%.*}
  clean="$lib/$base.jpg"
  ensure_dir "$lib"
  if [[ $clean == "$path" ]]; then
    # The name is already the one we would write: do it beside it, then swap.
    clean="$lib/.$base.$$.jpg"
    normalise_image "$path" "$clean" "$cap_w" "$cap_h" || { rm -f "$clean"; return 1; }
    mv -f "$clean" "$path"
    printf '%s' "$path"
    return 0
  fi
  normalise_image "$path" "$clean" "$cap_w" "$cap_h" || return 1

  # The credits follow the picture under its new name, then the original goes:
  # a favorite keeps a link to the rewritten file, a library copy is dropped.
  meta_put "$clean" "$(meta_get "$(basename "$path")" 2)" "$(meta_get "$(basename "$path")" 3)" \
    "$(meta_get "$(basename "$path")" 4)" "$(meta_get "$(basename "$path")" 5)" \
    "$(meta_get "$(basename "$path")" 6)" "$(meta_get "$(basename "$path")" 7)"
  chmod 644 "$clean" 2>/dev/null || true
  if [[ $path == "$fav"/* ]]; then
    rm -f "$path"
    ln "$clean" "$fav/$(basename "$clean")" 2>/dev/null || cp -f "$clean" "$fav/$(basename "$clean")" 2>/dev/null || true
  else
    meta_forget "$(basename "$path")"
    rm -f "$path"
  fi
  printf '%s' "$clean"
}

# The picture on screen outlives an upgrade, and the state file names its file.
# If that file is an original this plugin wrote before it normalised anything,
# the panel and the shell open it as soon as they read the state, so it is
# rewritten here, and the state, the link and the theme folder follow it.
shape_current_wallpaper() {
  local cur path shaped
  cur=$(cur_json 2>/dev/null) || return 0
  path=$(jq -r '.path // ""' <<<"$cur" 2>/dev/null)
  [[ -n $path && -f $path ]] || return 0
  # Nothing happens when the file is already in shape, which is the normal case.
  if ! shaped=$(ensure_shaped "$path" 2>/dev/null) || [[ -z $shaped || ! -f $shaped ]]; then
    # Nothing safe can be served from that file. The state stops naming it, so no
    # interface can open it, and the caller installs a fresh picture instead.
    jq -c '.path = "" | .shaped = false' <<<"$cur" >"$CURRENT_FILE" 2>/dev/null || true
    echo "fresque: the picture on screen could not be reshaped, it is no longer named" >&2
    return 1
  fi
  [[ $shaped == "$path" ]] && return 0
  apply_local "$shaped" >/dev/null 2>&1 || return 1
  echo "fresque: the picture on screen was an original, rewritten at $shaped" >&2
  return 0
}

apply_local() {
  local path=$1 base entry dims
  [[ -f $path ]] || return 1
  # Whatever is about to be applied goes through the same door as a download.
  path=$(ensure_shaped "$path") || return 1
  [[ -f $path ]] || return 1
  base=$(basename "$path")
  entry=$(jq -cn --arg s "$(meta_get "$base" 2)" --arg i "$(meta_get "$base" 3)" \
    --arg t "$(meta_get "$base" 7)" --arg c "$(meta_get "$base" 4)" \
    --arg l "$(meta_get "$base" 5)" --arg lic "$(meta_get "$base" 6)" \
    '{source: $s, id: $i, theme: $t, credit: $c, link: $l, license: $lic, width: 0, height: 0}')
  dims=$(image_dimensions "$path")
  if [[ -n $dims ]]; then
    local dw dh
    dw=$(dimension "${dims% *}") && dh=$(dimension "${dims##* }") &&
      entry=$(jq -c --argjson w "$dw" --argjson h "$dh" '.width = $w | .height = $h' <<<"$entry")
  fi
  set_background "$path"
  expose_in_theme "$path"
  write_current "$entry" "$path"
  printf '%s\n' "$path"
}

# Adds the picture on screen to the favorites. A hardlink rather than a move:
# the file the shell is displaying keeps its name so nothing flickers, and the
# favorite survives the library pruning because it is a second name for the
# same data. Where linking is not possible it degrades to a copy.
cmd_favorite() {
  ensure_config
  local cur path dir dest
  cur=$(cur_json)
  path=$(jq -r '.path // ""' <<<"$cur")
  [[ -n $path && -f $path ]] || die "nothing is on screen"
  dir=$(favorites_dir)
  ensure_dir "$dir"
  dest="$dir/$(basename "$path")"
  if [[ ! -e $dest ]]; then
    ln "$path" "$dest" 2>/dev/null || cp -f "$path" "$dest" || die "cannot add $path to $dir"
  fi
  printf '%s\n' "$dest"
}

# Removes the favorite. The library copy stays where it is, and when the
# library no longer has it, because it was pruned while favorited, the file
# moves back instead.
cmd_unfavorite() {
  ensure_config
  local cur path dir dest
  cur=$(cur_json)
  path=$(jq -r '.path // ""' <<<"$cur")
  [[ -n $path ]] || die "nothing is on screen"
  dir=$(library_dir)
  dest="$dir/$(basename "$path")"
  if is_favorite_path "$path"; then
    if [[ -e $dest ]]; then
      # The library still had its own copy, so removing the favorite link is
      # all there is to do and nothing on screen moves.
      rm -f "$path"
    else
      mv -f "$path" "$dest" || die "cannot move $path back into $dir"
      # The displayed file just changed name, so the background link and the
      # state file follow it. Its timestamp is refreshed so the pruning that
      # runs next treats it as a new arrival rather than the oldest file.
      touch "$dest"
      # A favorite can predate the day pictures were normalised: it is shaped
      # here too, since it is about to be put on screen.
      dest=$(ensure_shaped "$dest") || die "cannot use $dest"
      set_background "$dest"
      write_current "$(jq -c '{source,id,theme,credit,link,license,width,height}' <<<"$(cur_json)")" "$dest"
      cmd_prune "$(cfg keepLast)" "$dir"
    fi
  fi
  printf '%s\n' "$dest"
}

# Runs when the plugin loads. It writes the default config and installs a first
# wallpaper, so the answer to "what do I have to do" is nothing at all.
cmd_init() {
  ensure_config
  # A state file that outlived an upgrade can still name an original, so it is
  # shaped first. When nothing can be made of it, the file is no longer named and
  # a fresh wallpaper takes its place.
  shape_current_wallpaper
  if [[ -z $(jq -r '.path // ""' <<<"$(cur_json)") ]]; then
    cmd_next
    return $?
  fi
  return 0
}

# Drops the picture on screen and immediately serves another one. The id goes
# on the block list, so a preference expressed once is remembered.
cmd_skip() {
  ensure_config
  local cur src id path
  cur=$(cur_json)
  src=$(jq -r '.source // ""' <<<"$cur")
  id=$(jq -r '.id // ""' <<<"$cur")
  path=$(jq -r '.path // ""' <<<"$cur")
  [[ -n $src && -n $id ]] && block_item "$src" "$id"
  if [[ -n $path && -f $path ]]; then
    if is_favorite_path "$path"; then
      # A favorite is blocked, never deleted: that is the whole promise of
      # the favorites folder.
      :
    elif [[ $path == "$(library_dir)"/* ]]; then
      # Only a picture Fresque downloaded is removed. A wallpaper that belongs
      # to the system, or to the user, is blocked and left alone.
      meta_forget "$(basename "$path")"
      rm -f "$path"
      [[ $(cfg expose) == "true" ]] && rm -f "$(theme_dir)/$(basename "$path")" 2>/dev/null
    fi
  fi
  cmd_next
}

# Re-arms the rotation clock without touching the wallpaper. The service calls
# this when the interval changes, so switching from off to daily starts
# counting from now instead of firing on the spot.
cmd_touch() {
  ensure_dir "$STATE_DIR"
  local at cur
  at=$(now_ms)
  cur=$(cat "$CURRENT_FILE" 2>/dev/null)
  if [[ -n $cur ]]; then
    jq -c --argjson at "$at" '.appliedAt = $at | .retryAt = 0' <<<"$cur" >"$CURRENT_FILE"
  else
    jq -cn --argjson at "$at" '{appliedAt: $at, retryAt: 0}' >"$CURRENT_FILE"
  fi
}

cmd_status() {
  ensure_config
  local src entries="[]" current dir themes_json favdir favcount isfav favonly cur_path
  dir=$(library_dir)
  favdir=$(favorites_dir)
  for src in $SOURCE_IDS; do
    entries=$(jq -c --arg id "$src" --arg label "$(source_label "$src")" \
      --arg themes "$(source_themes "$src")" \
      --argjson on "$(source_enabled "$src" && printf true || printf false)" \
      --argjson match "$(source_matches_preferences "$src" && printf true || printf false)" \
      '. + [{id: $id, label: $label, themes: ($themes | split(" ")), enabled: $on, matches: $match}]' <<<"$entries")
  done

  current=$(cur_json)
  themes_json=$(jq -c '.themes' "$CONFIG_FILE" 2>/dev/null || printf '{}')
  cur_path=$(jq -r '.path // ""' <<<"$current")
  favcount=$(count_dir "$favdir")
  isfav=false
  is_current_favorite "$cur_path" && isfav=true
  favonly=false
  [[ $(cfg favoritesOnly) == "true" ]] && favonly=true

  jq -cn --argjson c "$current" --argjson s "$entries" \
    --argjson rotate "$(cfg rotateMinutes)" --argjson keep "$(cfg keepLast)" \
    --argjson themes "$themes_json" \
    --argjson lib "$(count_library "$dir")" \
    --argjson favorites "$favcount" --argjson isFavorite "$isfav" --argjson favoritesOnly "$favonly" \
    --argjson staged "$(stage_count)" \
    --argjson sourcesOn "$(count_words "$(enabled_sources)")" \
    --argjson themesOn "$(count_words "$(enabled_themes)")" \
    --arg libpath "$dir" --arg favpath "$favdir" --arg index "$INDEX_FILE" --arg lang "$(cfg language)" '{
      path: ($c.path // ""),
      source: ($c.source // ""),
      id: ($c.id // ""),
      theme: ($c.theme // ""),
      language: $lang,
      credit: ($c.credit // ""),
      link: ($c.link // ""),
      license: ($c.license // ""),
      width: ($c.width // 0),
      height: ($c.height // 0),
      appliedAt: ($c.appliedAt // 0),
      retryAt: ($c.retryAt // 0),
      rotateMinutes: $rotate,
      keepLast: $keep,
      themes: $themes,
      library: $lib,
      libraryPath: $libpath,
      favorites: $favorites,
      favoritesOnly: $favoritesOnly,
      isFavorite: $isFavorite,
      staged: $staged,
      sourcesOn: $sourcesOn,
      themesOn: $themesOn,
      favoritesPath: $favpath,
      indexFile: $index,
      sources: $s
    }'
}

# Asks every source and theme for one answer, without changing anything on
# screen. Used by hand and by the repository's checks.
cmd_verify() {
  ensure_config
  local wh min_w min_h src t n ok=0
  wh=$(screen_geometry)
  min_w=$(dimension "${wh% *}") || min_w=1920
  min_h=$(dimension "${wh##* }") || min_h=1080
  for src in $SOURCE_IDS; do
    for t in $(source_themes "$src"); do
      n=$(fetch_candidates "$src" "$t" "$min_w" "$min_h" 2>/dev/null | jq 'length' 2>/dev/null)
      [[ ${n:-0} -gt 0 ]] 2>/dev/null || continue
      ok=$((ok + 1))
      printf '%s\t%s\t%s\n' "$src" "$t" "$n"
    done
  done
  ((ok > 0)) || die "no source responded"
  return 0
}

cmd_config() {
  case "${1:-show}" in
    show) ensure_config; cat "$CONFIG_FILE" ;;
    path) printf '%s\n' "$CONFIG_FILE" ;;
    get)  cfg "${2:?usage: fresque config get <key>}" ;;
    set)  cfg_set "${2:?usage: fresque config set <key> <value>}" "${3-}" ;;
    *)    die "unknown config subcommand: $1" ;;
  esac
}

usage() {
  cat <<'USAGE'
fresque: quality wallpapers for Omarchy

  fresque init                 Write the default config and install a first wallpaper
  fresque next                 Apply the next wallpaper (instant when one is ready)
  fresque prefetch [n]         Download the next <n> wallpapers in advance
  fresque skip                 Block the current wallpaper and serve another one
  fresque favorite             Move the current wallpaper into the favorites folder
  fresque unfavorite           Move it back into the library
  fresque status               Current wallpaper, rotation, themes, sources, favorites as JSON
  fresque verify               Ask every source and theme for one answer
  fresque clean [keep]         Trim the library to the newest <keep> images
  fresque touch                Re-arm the rotation clock without changing the picture
  fresque config show|get|set|path
  fresque help
USAGE
}

case "${1:-help}" in
  init)       cmd_init ;;
  next)       shift; cmd_next "$@" ;;
  prefetch)   shift; cmd_prefetch "$@" ;;
  skip)       cmd_skip ;;
  favorite)   cmd_favorite ;;
  unfavorite) cmd_unfavorite ;;
  status)     cmd_status ;;
  verify)     cmd_verify ;;
  clean)      shift; ensure_config
              cmd_prune "${1:-$(cfg keepLast)}" "$(library_dir)"
              prune_theme_dir "$(theme_dir)" "$(cfg keepLast)"
              jq -cn --argjson n "$(count_library "$(library_dir)")" --argjson f "$(count_dir "$(favorites_dir)")" '{library: $n, favorites: $f}' ;;
  touch)      cmd_touch ;;
  config)     shift; cmd_config "$@" ;;
  help|-h|--help) usage ;;
  *) die "unknown command: $1 (try: fresque help)" ;;
esac
