#!/bin/bash
# fresque: quality wallpapers for Omarchy, with nothing to configure.
#
# Every network call and every piece of JSON handling lives here. The QML
# surfaces (bar pill, panel, rotation service) only run this script and read
# the JSON it prints, so none of them ever builds a command string.
#
# No API key is needed for any source, and the applied image is kept locally,
# which is what makes the rotation work offline.

set -uo pipefail

CONFIG_FILE="${FRESQUE_CONFIG:-$HOME/.config/omarchy/fresque.json}"
STATE_DIR="${FRESQUE_STATE_DIR:-$HOME/.local/state/fresque}"
CURRENT_FILE="$STATE_DIR/current.json"
SEEN_FILE="$STATE_DIR/seen.tsv"
INDEX_FILE="$STATE_DIR/library.tsv"
BLOCKED_FILE="$STATE_DIR/blocked.tsv"

CONFIG_VERSION=2
FILE_PREFIX="fresque-"
# Delay after a failed attempt, in milliseconds: an offline laptop should retry
# in minutes, not after a whole rotation interval.
RETRY_MS=300000
# Ids remembered so a rotation never serves the same picture twice.
SEEN_KEEP=400
# 64 MiB is far above any wallpaper here and far below anything that could
# fill the disk if a source misbehaves.
MAX_IMAGE_BYTES=67108864
MAX_JSON_BYTES=8388608

PAGE_SIZE=50

die() { echo "fresque: $*" >&2; exit 1; }

# ---------------------------------------------------------------- requests

# A user agent that names the plugin, so a source's maintainers can see who is
# asking. It applies to every request, JSON or image.
USER_AGENT="fresque/2.0 (Omarchy wallpaper plugin, +https://github.com/mitch/fresque)"

# HTTPS is required for the request and for every redirect, so a source or a
# compromised CDN cannot downgrade a fetch to plain HTTP.
curl_json() {
  curl --proto '=https' --proto-redir '=https' --max-filesize "$MAX_JSON_BYTES" \
    --max-time 25 --silent --show-error --location --fail \
    -A "$USER_AGENT" -H 'Accept: application/json' "$1"
}

curl_file() {
  curl --proto '=https' --proto-redir '=https' --max-filesize "$MAX_IMAGE_BYTES" \
    --max-time 180 --silent --show-error --location --fail \
    -A "$USER_AGENT" -o "$2" "$1"
}

urlencode() { jq -rn --arg v "$1" '$v|@uri'; }

now_ms() { date +%s%3N; }

# ---------------------------------------------------------------- files

# Refuses to write into anything that is not a plain directory owned by the
# user, so a symlink planted at a guessable path cannot redirect our writes.
ensure_dir() {
  local dir=$1
  [[ -d $dir ]] || mkdir -p "$dir" || die "cannot create $dir"
  [[ -d $dir ]] || die "$dir is not a directory"
  [[ -O $dir ]] || die "$dir is not owned by you"
}

default_library() { printf '%s' "$HOME/Pictures/Fresque"; }

library_dir() {
  local dir="${FRESQUE_LIBRARY:-}"
  [[ -n $dir ]] || dir=$(cfg library)
  [[ -n $dir ]] || dir=$(default_library)
  printf '%s' "${dir/#\~/$HOME}"
}

theme_name() { cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || echo "default"; }

# The native background picker only cycles files that sit in the theme's own
# folder, so each applied image is linked there. On one filesystem that link is
# a hardlink and costs nothing, across two it is a symlink and still costs
# nothing.
theme_dir() { printf '%s' "$HOME/.config/omarchy/backgrounds/$(theme_name)"; }

slugify() {
  local s
  s=$(printf '%s' "$1" |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/\.(jpe?g|png|webp|avif|tiff?)$//' |
    sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
  printf '%s' "${s:0:60}"
}

image_ext() {
  local u=${1%%\?*}
  case ${u##*.} in
    jpg|JPG|jpeg|JPEG) printf 'jpg' ;;
    png|PNG)           printf 'png' ;;
    webp|WEBP)         printf 'webp' ;;
    avif|AVIF)         printf 'avif' ;;
    *)                 printf 'jpg' ;;
  esac
}

# Real pixel size of a downloaded file. libvips ships with Omarchy (the image
# picker uses it), ImageMagick is a fallback, and when neither is present the
# size gate is skipped rather than blocking the plugin.
image_dimensions() {
  local out
  if command -v vipsheader >/dev/null 2>&1; then
    out=$(vipsheader "$1" 2>/dev/null | sed -n 's/.*: \([0-9][0-9]*\)x\([0-9][0-9]*\) .*/\1 \2/p')
    [[ -n $out ]] && { printf '%s' "$out"; return 0; }
  fi
  if command -v magick >/dev/null 2>&1; then
    out=$(magick identify -format '%w %h' "$1" 2>/dev/null)
    [[ -n $out ]] && { printf '%s' "$out"; return 0; }
  fi
  return 1
}

# A truncated body, an HTML error page or an SVG (which can pull in remote
# resources and blow up the renderer) must never become a wallpaper.
verify_image() {
  local file=$1 mime
  [[ -s $file ]] || return 1
  mime=$(file -b --mime-type "$file" 2>/dev/null) || return 1
  case $mime in
    image/jpeg|image/png|image/webp|image/avif) ;;
    *) return 1 ;;
  esac
  [[ $(stat -c %s "$file") -gt 20480 ]] || return 1
  return 0
}

# ---------------------------------------------------------------- config

DEFAULT_CONFIG='{
  "version": 3,
  "rotateMinutes": 1440,
  "sources": { "bing": true, "wikimedia": true, "konachan": true, "picsum": true },
  "themes": { "nature": true, "space": true, "architecture": true, "animals": true, "photos": true, "anime": true },
  "keepLast": 30,
  "expose": true,
  "library": ""
}'

CONFIG_KEYS="rotateMinutes keepLast expose library sources.<id> themes.<id>"

ensure_config() {
  if [[ -f $CONFIG_FILE ]]; then
    local version
    version=$(jq -r '.version // 0' "$CONFIG_FILE" 2>/dev/null || echo 0)
    [[ $version == "$CONFIG_VERSION" ]] && return 0
    cp -f "$CONFIG_FILE" "$CONFIG_FILE.bak" 2>/dev/null
    echo "fresque: config was schema v$version, replaced with v$CONFIG_VERSION" >&2
  fi
  ensure_dir "$(dirname "$CONFIG_FILE")"
  printf '%s\n' "$DEFAULT_CONFIG" >"$CONFIG_FILE" || die "cannot write $CONFIG_FILE"
}

cfg() {
  ensure_config
  jq -r --arg k "$1" --argjson d "$DEFAULT_CONFIG" \
    'if (.[$k] == null) then ($d[$k] // "") else .[$k] end' "$CONFIG_FILE" 2>/dev/null ||
    jq -r --arg k "$1" '.[$k] // ""' <<<"$DEFAULT_CONFIG"
}

# Written in place, never through a temporary file and a rename: a rename swaps
# the inode and the shell loses the file watch it holds, so the service would
# keep running on a config that no longer exists.
cfg_write() {
  printf '%s\n' "$1" >"$CONFIG_FILE" || die "cannot write $CONFIG_FILE"
}

cfg_set() {
  ensure_config
  local key=$1 value=${2-} tmp
  case $key in
    rotateMinutes)
      case $value in 0|5|15|30|60|180|360|1440) ;; *) die "rotateMinutes must be one of 0 5 15 30 60 180 360 1440, got: $value" ;; esac
      tmp=$(jq --argjson v "$value" '.rotateMinutes = $v' "$CONFIG_FILE") ;;
    keepLast)
      [[ $value =~ ^[0-9]{1,3}$ ]] || die "keepLast must be a number of images between 1 and 999, got: $value"
      ((value > 0)) || die "keepLast must be at least 1"
      tmp=$(jq --argjson v "$value" '.keepLast = $v' "$CONFIG_FILE") ;;
    expose)
      case $value in true|false) ;; *) die "expose must be true or false, got: $value" ;; esac
      tmp=$(jq --argjson v "$value" '.expose = $v' "$CONFIG_FILE") ;;
    library)
      [[ -z $value || $value == /* ]] || die "library must be an absolute path or empty"
      tmp=$(jq --arg v "$value" '.library = $v' "$CONFIG_FILE") ;;
    sources.*)
      local src=${key#sources.}
      is_source "$src" || die "unknown source: $src"
      case $value in true|false) ;; *) die "source state must be true or false, got: $value" ;; esac
      tmp=$(jq --arg s "$src" --argjson v "$value" '.sources[$s] = $v' "$CONFIG_FILE") ;;
    themes.*)
      local theme=${key#themes.}
      is_theme "$theme" || die "unknown theme: $theme"
      case $value in true|false) ;; *) die "theme state must be true or false, got: $value" ;; esac
      tmp=$(jq --arg t "$theme" --argjson v "$value" '.themes[$t] = $v' "$CONFIG_FILE") ;;
    *) die "unknown config key: $key (try: $CONFIG_KEYS)" ;;
  esac
  [[ -n $tmp ]] || die "failed to update $key"
  cfg_write "$tmp"
}

# ---------------------------------------------------------------- themes

THEME_IDS="nature space architecture animals photos anime"

is_theme() { [[ " $THEME_IDS " == *" $1 "* ]]; }

# Where each theme is served from. Wikimedia categories are the community's own
# curated sets, and the Konachan tags are the ones that reliably hold 4K
# pictures rather than small illustrations.
CATALOG='{
  "nature":       { "wikimedia": "Featured_pictures_of_nature,Featured_pictures_of_landscapes,Quality_images_of_landscapes", "konachan": "" },
  "space":        { "wikimedia": "Featured_pictures_of_astronomy,Quality_images_of_astronomy", "konachan": "" },
  "architecture": { "wikimedia": "Featured_pictures_of_architecture,Quality_images_of_architecture", "konachan": "" },
  "animals":      { "wikimedia": "Quality_images_of_birds,Quality_images_of_insects", "konachan": "" },
  "photos":       { "wikimedia": "", "konachan": "" },
  "anime":        { "wikimedia": "", "konachan": "landscape,sky,night,city,water,cherry_blossoms,flowers,clouds,stars,sunset,winter,moon,building" }
}'

SOURCE_IDS="bing wikimedia konachan picsum"
SOURCE_WEIGHTS="bing=20 wikimedia=45 konachan=20 picsum=15"

is_source() { [[ " $SOURCE_IDS " == *" $1 "* ]]; }

source_label() {
  case $1 in
    bing)      printf 'Bing' ;;
    wikimedia) printf 'Wikimedia Commons' ;;
    konachan)  printf 'Konachan' ;;
    picsum)    printf 'Unsplash' ;;
  esac
}

source_weight() { local kv; for kv in $SOURCE_WEIGHTS; do [[ ${kv%%=*} == "$1" ]] && { printf '%s' "${kv#*=}"; return; }; done; printf '0'; }

source_enabled() {
  local v
  v=$(jq -r --arg s "$1" '.sources[$s] // false' "$CONFIG_FILE" 2>/dev/null)
  [[ $v == "true" ]]
}

theme_enabled() {
  local v
  v=$(jq -r --arg t "$1" '.themes[$t] // false' "$CONFIG_FILE" 2>/dev/null)
  [[ $v == "true" ]]
}

catalog_get() { jq -r --arg t "$1" --arg s "$2" '.[$t][$s] // ""' <<<"$CATALOG" 2>/dev/null; }

# Which themes a source can serve. Bing is the day's picture and Picsum serves
# nothing but Picsum, so neither can be filtered by theme; the panel says so
# next to the source instead of hiding it.
source_themes() {
  case $1 in
    bing)      printf 'nature space architecture animals photos' ;;
    wikimedia) printf 'nature space architecture animals' ;;
    konachan)  printf 'anime' ;;
    picsum)    printf 'photos' ;;
  esac
}

enabled_themes() {
  local t out=""
  for t in $THEME_IDS; do theme_enabled "$t" && out+="$t "; done
  printf '%s' "${out% }"
}

enabled_sources() {
  local s out=""
  for s in $SOURCE_IDS; do source_enabled "$s" && out+="$s "; done
  printf '%s' "${out% }"
}

# A source is usable when it is switched on and at least one of the themes it
# can serve is on. This is the preference filter, and it runs before any
# request goes out rather than after a picture is already on screen.
source_matches_preferences() {
  local src=$1 t
  for t in $(source_themes "$src"); do
    theme_enabled "$t" && return 0
  done
  return 1
}

pick_source() {
  local total=0 src w pick
  for src in $SOURCE_IDS; do
    source_enabled "$src" || continue
    source_matches_preferences "$src" || continue
    w=$(source_weight "$src")
    total=$((total + w))
  done
  ((total > 0)) || return 1
  pick=$((RANDOM % total))
  for src in $SOURCE_IDS; do
    source_enabled "$src" || continue
    source_matches_preferences "$src" || continue
    w=$(source_weight "$src")
    if ((pick < w)); then printf '%s' "$src"; return 0; fi
    pick=$((pick - w))
  done
  return 1
}

# One theme the chosen source can serve, picked at random among the enabled
# ones, so a rotation with several themes on does not always query the same one.
pick_theme_for() {
  local src=$1 t options=()
  for t in $(source_themes "$src"); do
    theme_enabled "$t" && options+=("$t")
  done
  ((${#options[@]} > 0)) || { printf '%s' "photos"; return 0; }
  printf '%s' "${options[$((RANDOM % ${#options[@]}))]}"
}

# ---------------------------------------------------------------- screen

# The quality gate. A wallpaper has to be at least as large as the screen it
# will be cropped onto, and close enough to that screen's aspect ratio that the
# crop does not eat half the picture.
screen_geometry() {
  local wh
  wh=$(hyprctl monitors -j 2>/dev/null |
    jq -r 'if type=="array" and length>0 then ([.[]|select(.disabled!=true)]|sort_by(.width*.height)|last|"\(.width) \(.height)") else "" end' 2>/dev/null)
  [[ $wh =~ ^[0-9]+\ [0-9]+$ ]] || wh="1920 1080"
  printf '%s' "$wh"
}

# Shape of a picture that can fill a widescreen desktop without a destructive
# crop. Landscape, at least 5:4, at most 2.7:1. A portrait photograph of the
# same pixel count ends up as a band across the middle, and an extreme panorama
# loses its subject, so neither counts as a wallpaper worth serving here.
aspect_ok() {
  local w=$1 h=$2
  awk -v a="$w" -v b="$h" 'BEGIN { if (b <= 0) exit 1; r = a / b; exit !(r >= 1.2 && r <= 2.7) }'
}

# ---------------------------------------------------------------- sources
#
# Every source normalizes to the same record shape, so nothing downstream has
# to know which API it came from:
#   { source, id, theme, full, alt, thumb, width, height, credit, link, license }

# Bing publishes the same picture at several sizes. UHD is 3840x2160 and is only
# generated for recent images, so the 1080p variant travels along as the
# fallback and the size gate rejects it when the screen is bigger.
candidates_bing() {
  curl_json "https://www.bing.com/HPImageArchive.aspx?format=js&idx=0&n=8&mkt=en-US" |
    jq -c '[.images[]? | {
      source: "bing",
      id: (.startdate // .enddate),
      theme: "any",
      full: ("https://www.bing.com" + .urlbase + "_UHD.jpg&pid=hp"),
      alt: ("https://www.bing.com" + (.url // "")),
      thumb: ("https://www.bing.com" + (.url // "")),
      width: 3840,
      height: 2160,
      credit: ((.title // "") + ", " + (.copyright // "")),
      link: "https://www.bing.com",
      license: "Bing, credited to its author"
    }]'
}

# Wikimedia Commons is where the best freely licensed photography lives. The
# 3840px thumbnail is fetched rather than the original, because originals are
# sometimes 60 MB TIFFs and this is a wallpaper, not an archive.
candidates_wikimedia() {
  local theme=$1 min_w=$2 min_h=$3 category scaled=3840
  ((min_w > scaled)) && scaled=$min_w
  category=$(catalog_get "$theme" wikimedia | tr ',' '\n' | grep -v '^$' | shuf -n 1)
  [[ -n $category ]] || { printf '[]'; return 0; }
  curl_json "https://commons.wikimedia.org/w/api.php?action=query&format=json&generator=categorymembers&gcmtitle=Category:$(urlencode "$category")&gcmtype=file&gcmlimit=$PAGE_SIZE&prop=imageinfo&iiprop=url%7Csize%7Cextmetadata&iiurlwidth=$scaled" |
    jq -c --argjson minw "$min_w" --argjson minh "$min_h" --arg theme "$theme" \
      '[.query.pages[]? | (.imageinfo[0] // {}) as $ii | {
        source: "wikimedia",
        id: ((.title // "") | sub("^File:"; "")),
        theme: $theme,
        full: ($ii.thumburl // $ii.url),
        alt: ($ii.url // ""),
        thumb: ($ii.thumburl // $ii.url),
        width: ($ii.width // 0),
        height: ($ii.height // 0),
        credit: (((($ii.extmetadata.Artist.value // "")) | gsub("<[^>]*>"; "") | gsub("\\s+"; " ")) | ltrimstr(" ") | rtrimstr(" ")),
        link: ("https://commons.wikimedia.org/wiki/" + ((.title // "") | @uri)),
        license: ($ii.extmetadata.LicenseShortName.value // "Free license")
      } | select(.width >= $minw and .height >= $minh)]'
}

# Konachan is the safe side of an image board built around wallpapers: it is
# where anime art at 4K and beyond lives, tagged by scene, with the artist and
# the original page on every post. The safe rating and the minimum size are part
# of the query rather than a promise, so a request is spent on something that
# can actually fill the screen.
candidates_konachan() {
  local theme=$1 min_w=$2 min_h=$3 tag
  tag=$(catalog_get "$theme" konachan | tr ',' '\n' | grep -v '^$' | shuf -n 1)
  [[ -n $tag ]] || { printf '[]'; return 0; }
  curl_json "https://konachan.net/post.json?tags=rating%3Asafe+width%3A%3E%3D${min_w}+height%3A%3E%3D${min_h}+$(urlencode "$tag")+order%3Arandom&limit=24" |
    jq -c --arg theme "$theme" '[.[]? | select(.file_url != null and .id != null) | {
      source: "konachan",
      id: (.id | tostring),
      theme: $theme,
      full: .file_url,
      alt: (.jpeg_url // ""),
      thumb: (.preview_url // .sample_url),
      width: (.width // 0),
      height: (.height // 0),
      credit: (if (.author // "") == "tagme" then "" else (.author // "") end),
      link: ("https://konachan.net/post/show/" + (.id | tostring)),
      license: "Fan art, credited to its artist"
    }]'
}
# Picsum serves Unsplash photographs through its own API with nothing to sign
# up for. The picture is requested at the screen's own size, so the server does
# the crop instead of the renderer and nothing is upscaled.
candidates_picsum() {
  local min_w=$1 min_h=$2 page
  page=$((RANDOM % 12 + 1))
  curl_json "https://picsum.photos/v2/list?page=$page&limit=40" |
    jq -c --argjson minw "$min_w" --argjson minh "$min_h" \
      '[.[]? | select(.width >= $minw and .height >= $minh) | {
        source: "picsum",
        id: (.id // ""),
        theme: "photos",
        full: ("https://picsum.photos/id/" + (.id // "") + "/" + ($minw | tostring) + "/" + ($minh | tostring)),
        alt: (.download_url // ""),
        thumb: ("https://picsum.photos/id/" + (.id // "") + "/800/450"),
        width: $minw,
        height: $minh,
        credit: (.author // ""),
        link: (.url // "https://picsum.photos"),
        license: "Unsplash License"
      }]'
}

fetch_candidates() {
  local src=$1 theme=$2 min_w=$3 min_h=$4 rows row w h out="[]"
  case $src in
    bing)      rows=$(candidates_bing) ;;
    wikimedia) rows=$(candidates_wikimedia "$theme" "$min_w" "$min_h") ;;
    konachan)  rows=$(candidates_konachan "$theme" "$min_w" "$min_h") ;;
    picsum)    rows=$(candidates_picsum "$min_w" "$min_h") ;;
    *)         printf '[]'; return 0 ;;
  esac
  [[ -n $rows && $rows != "null" ]] || { printf '[]'; return 0; }
  # Size and shape are checked on the metadata a source declares.
  while IFS= read -r row; do
    w=$(jq -r '.width // 0' <<<"$row"); h=$(jq -r '.height // 0' <<<"$row")
    if [[ $w == "0" || $h == "0" ]]; then
      out=$(jq -c --argjson r "$row" '. + [$r]' <<<"$out")
      continue
    fi
    ((w >= min_w && h >= min_h)) || continue
    aspect_ok "$w" "$h" || continue
    out=$(jq -c --argjson r "$row" '. + [$r]' <<<"$out")
  done < <(jq -c '.[]' <<<"$rows" 2>/dev/null)
  printf '%s' "$out"
}

# ---------------------------------------------------------------- library
#
# The library directory holds wallpapers and nothing else. Every piece of
# metadata lives in the state directory: a folder of images stays a folder of
# images, which is what people expect when they open it.

meta_put() {
  local file=$1 source=$2 id=$3 credit=$4 link=$5 license=$6 theme=$7 base
  ensure_dir "$STATE_DIR"
  base=$(basename "$file")
  meta_forget "$base"
  # Tabs and newlines inside a credit would break the row, so they are folded.
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$base" "$source" "$id" \
    "$(printf '%s' "$credit" | tr '\t\n' '  ')" "$link" "$license" "$theme" >>"$INDEX_FILE"
}

meta_forget() {
  local base=$1
  [[ -f $INDEX_FILE ]] || return 0
  awk -F'\t' -v f="$base" '$1!=f' "$INDEX_FILE" >"$INDEX_FILE.new" 2>/dev/null &&
    mv -f "$INDEX_FILE.new" "$INDEX_FILE"
}

meta_get() {
  local base=$1 field=$2
  [[ -f $INDEX_FILE ]] || return 1
  awk -F'\t' -v f="$base" -v n="$field" '$1==f { print $n }' "$INDEX_FILE" | tail -1
}

list_library() {
  local dir=$1
  [[ -d $dir ]] || return 0
  find "$dir" -maxdepth 1 -type f -name "$FILE_PREFIX*" -printf '%T@\t%p\n' 2>/dev/null |
    sort -rn | cut -f2-
}

count_library() {
  local dir=$1
  [[ -d $dir ]] || { printf '0'; return 0; }
  find "$dir" -maxdepth 1 -type f -name "$FILE_PREFIX*" 2>/dev/null | wc -l | tr -d ' '
}

# Keeps the newest N images, so the folder cannot grow without end. The one on
# screen is never deleted, and the theme folder is trimmed to the same set.
cmd_prune() {
  local keep=$1 dir=$2 current victim
  [[ $keep =~ ^[0-9]+$ ]] || keep=30
  ((keep > 0)) || return 0
  [[ -d $dir ]] || return 0
  current=$(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null)

  while (($(count_library "$dir") > keep)); do
    victim=$(list_library "$dir" | grep -v "^$current$" | tail -1)
    [[ -n $victim ]] || break
    meta_forget "$(basename "$victim")"
    rm -f "$victim"
  done
  return 0
}

# Drops the theme-folder entries whose image is gone, then keeps the newest N,
# so the native picker never lists a wallpaper that no longer exists.
prune_theme_dir() {
  local dir=$1 keep=$2 files=() i
  [[ -d $dir ]] || return 0
  while IFS= read -r f; do
    [[ -e $f ]] || { rm -f "$f"; continue; }
    files+=("$f")
  done < <(find "$dir" -maxdepth 1 -name "$FILE_PREFIX*" -printf '%T@\t%p\n' 2>/dev/null | sort -rn | cut -f2-)

  for ((i = keep; i < ${#files[@]}; i++)); do
    rm -f "${files[$i]}"
  done
}

expose_in_theme() {
  local path=$1 dir
  [[ ${FRESQUE_DRY_RUN:-0} == 1 ]] && return 0
  [[ $(cfg expose) == "true" ]] || return 0
  dir=$(theme_dir)
  ensure_dir "$dir" || return 0
  ln -f "$path" "$dir/$(basename "$path")" 2>/dev/null ||
    ln -sf "$path" "$dir/$(basename "$path")" 2>/dev/null || true
}

set_background() {
  local path=$1
  # Test seam: FRESQUE_DRY_RUN=1 exercises the whole fetch, verify and prune
  # path without touching the desktop background or the theme folder.
  [[ ${FRESQUE_DRY_RUN:-0} == 1 ]] && return 0
  omarchy theme bg set "$path" >/dev/null 2>&1 && return 0
  omarchy-theme-bg-set "$path" >/dev/null 2>&1 && return 0
  die "failed to set the background"
}

# ---------------------------------------------------------------- history

mark_seen() {
  ensure_dir "$STATE_DIR"
  printf '%s\t%s\n' "$1" "$2" >>"$SEEN_FILE" 2>/dev/null
  if [[ -f $SEEN_FILE ]] && [[ $(wc -l <"$SEEN_FILE") -gt $SEEN_KEEP ]]; then
    tail -n "$SEEN_KEEP" "$SEEN_FILE" >"$SEEN_FILE.new" && mv -f "$SEEN_FILE.new" "$SEEN_FILE"
  fi
}

was_seen() { [[ -f $SEEN_FILE ]] && grep -qxF "$1	$2" "$SEEN_FILE"; }

is_blocked() { [[ -f $BLOCKED_FILE ]] && grep -qxF "$1	$2" "$BLOCKED_FILE"; }

block_item() {
  ensure_dir "$STATE_DIR"
  is_blocked "$1" "$2" || printf '%s\t%s\n' "$1" "$2" >>"$BLOCKED_FILE"
}

# ---------------------------------------------------------------- applying

choose_candidate() {
  local rows=$1 src id fresh unseen row
  fresh=$(jq -c '[.[] | select(.full != "" and .id != "")]' <<<"$rows" 2>/dev/null)
  [[ $(jq 'length' <<<"${fresh:-[]}" 2>/dev/null) -gt 0 ]] || return 1

  unseen=$(collect_unseen "$fresh")
  if [[ $(jq 'length' <<<"$unseen" 2>/dev/null) -eq 0 ]]; then
    # Everything has been seen before. Rather than failing, take the whole
    # pool again with the blocked entries still removed.
    unseen=$(collect_unseen "$fresh" 1)
  fi
  [[ $(jq 'length' <<<"$unseen" 2>/dev/null) -gt 0 ]] || return 1
  jq -c --argjson n "$(jq 'length' <<<"$unseen")" '.[ (now * 1000 | floor) % $n ]' <<<"$unseen"
}

collect_unseen() {
  local rows=$1 ignore_seen=${2:-0} row src id out="[]"
  while IFS= read -r row; do
    src=$(jq -r '.source' <<<"$row"); id=$(jq -r '.id' <<<"$row")
    is_blocked "$src" "$id" && continue
    if ((ignore_seen == 0)); then
      was_seen "$src" "$id" && continue
    fi
    out=$(jq -c --argjson r "$row" '. + [$r]' <<<"$out")
  done < <(jq -c '.[]' <<<"$rows" 2>/dev/null)
  printf '%s' "$out"
}

write_current() {
  local photo=$1 path=$2
  ensure_dir "$STATE_DIR"
  jq -cn --argjson p "$photo" --arg path "$path" --argjson at "$(now_ms)" '{
    path: $path,
    source: ($p.source // ""),
    id: ($p.id // ""),
    theme: ($p.theme // ""),
    credit: ($p.credit // ""),
    link: ($p.link // ""),
    license: ($p.license // ""),
    width: ($p.width // 0),
    height: ($p.height // 0),
    appliedAt: $at,
    retryAt: 0
  }' >"$CURRENT_FILE"
}

cur_json() { [[ -s $CURRENT_FILE ]] && cat "$CURRENT_FILE" || printf '{}'; }

# After a failure the next attempt is due in five minutes, so an offline laptop
# retries soon instead of waiting out a whole day.
note_failure() {
  ensure_dir "$STATE_DIR"
  local at cur
  at=$(now_ms)
  cur=$(cat "$CURRENT_FILE" 2>/dev/null)
  if [[ -n $cur ]]; then
    jq -c --argjson r "$((at + RETRY_MS))" '.retryAt = $r' <<<"$cur" >"$CURRENT_FILE"
  else
    jq -cn --argjson r "$((at + RETRY_MS))" '{retryAt: $r, appliedAt: 0}' >"$CURRENT_FILE"
  fi
}

# Downloads, checks and installs one candidate. Returns non-zero without
# touching the screen when the file is not usable, so the caller can try
# another source.
apply_photo() {
  local photo=$1 min_w=$2 min_h=$3
  local id src theme slug full alt ext dir dest tmp dims w h
  id=$(jq -r '.id // ""' <<<"$photo")
  src=$(jq -r '.source // ""' <<<"$photo")
  theme=$(jq -r '.theme // ""' <<<"$photo")
  full=$(jq -r '.full // ""' <<<"$photo")
  alt=$(jq -r '.alt // ""' <<<"$photo")
  [[ -n $id && -n $full ]] || return 1
  # Nothing but https ever reaches curl, whatever a source claims.
  case $full in https://*) ;; *) return 1 ;; esac
  case $alt in https://*|"") ;; *) alt="" ;; esac

  ext=$(image_ext "$full")
  slug=$(slugify "$id")
  [[ -n $slug ]] || slug=$(printf '%s' "$id" | tr -cd 'a-z0-9')
  dir=$(library_dir)
  ensure_dir "$dir"
  dest="$dir/$FILE_PREFIX$src-$slug.$ext"

  if [[ ! -s $dest ]]; then
    tmp=$(mktemp "$dir/.$FILE_PREFIX$src-$slug.XXXXXX") || return 1
    if ! curl_file "$full" "$tmp"; then
      rm -f "$tmp"
      if [[ -n $alt ]]; then
        tmp=$(mktemp "$dir/.$FILE_PREFIX$src-$slug.XXXXXX") || return 1
        curl_file "$alt" "$tmp" || { rm -f "$tmp"; note_failure; return 1; }
      else
        note_failure
        return 1
      fi
    fi
    if ! verify_image "$tmp"; then
      rm -f "$tmp"; note_failure; return 1
    fi
    # Measured, not trusted: a source may promise 4K and deliver 1024 pixels,
    # and a wallpaper smaller than the screen is what this plugin exists to
    # avoid.
    dims=$(image_dimensions "$tmp")
    if [[ -n $dims ]]; then
      w=${dims% *}; h=${dims#* }
      if ((w < min_w || h < min_h)) || ! aspect_ok "$w" "$h"; then
        rm -f "$tmp"
        note_failure
        return 1
      fi
      photo=$(jq -c --argjson w "$w" --argjson h "$h" '.width = $w | .height = $h' <<<"$photo")
    fi
    mv -f "$tmp" "$dest"
    chmod 644 "$dest"
  fi

  set_background "$dest"
  expose_in_theme "$dest"
  write_current "$photo" "$dest"
  meta_put "$dest" "$src" "$id" "$(jq -r '.credit // ""' <<<"$photo")" \
    "$(jq -r '.link // ""' <<<"$photo")" "$(jq -r '.license // ""' <<<"$photo")" "$theme"
  mark_seen "$src" "$id"
  cmd_prune "$(cfg keepLast)" "$dir"
  prune_theme_dir "$(theme_dir)" "$(cfg keepLast)"
  printf '%s\n' "$dest"
  return 0
}

# ---------------------------------------------------------------- commands

cmd_next() {
  ensure_config
  local wh min_w min_h attempt src theme rows pick failed=" " rc=1 enabled
  wh=$(screen_geometry); min_w=${wh% *}; min_h=${wh#* }
  enabled=$(enabled_sources)
  [[ -n $enabled ]] || die "every source is switched off"
  enabled_themes >/dev/null
  [[ -n $(enabled_themes) ]] || die "every theme is switched off"

  for attempt in 1 2 3 4 5 6; do
    src=$(pick_source) || break
    [[ $failed == *" $src "* ]] && continue
    theme=$(pick_theme_for "$src")
    rows=$(fetch_candidates "$src" "$theme" "$min_w" "$min_h" 2>/dev/null)
    pick=""
    [[ -n $rows && $rows != "null" ]] && pick=$(choose_candidate "$rows" 2>/dev/null)
    if [[ -n $pick && $pick != "null" ]] && apply_photo "$pick" "$min_w" "$min_h"; then
      rc=0
      break
    fi
    failed+="$src "
  done

  ((rc == 0)) || { note_failure; die "no source could provide a wallpaper right now"; }
  return 0
}

# Runs when the plugin loads. It writes the default config and installs a first
# wallpaper, so the answer to "what do I have to do" is nothing at all.
cmd_init() {
  ensure_config
  if [[ -z $(jq -r '.path // ""' <<<"$(cur_json)") ]]; then
    cmd_next
    return $?
  fi
  return 0
}

# Drops the picture on screen and immediately serves another one. The id goes
# on the block list, so a preference expressed once is remembered.
cmd_skip() {
  ensure_config
  local cur src id path
  cur=$(cur_json)
  src=$(jq -r '.source // ""' <<<"$cur")
  id=$(jq -r '.id // ""' <<<"$cur")
  path=$(jq -r '.path // ""' <<<"$cur")
  [[ -n $src && -n $id ]] && block_item "$src" "$id"
  if [[ -n $path && -f $path ]]; then
    meta_forget "$(basename "$path")"
    rm -f "$path"
    [[ $(cfg expose) == "true" ]] && rm -f "$(theme_dir)/$(basename "$path")" 2>/dev/null
  fi
  cmd_next
}

# Re-arms the rotation clock without touching the wallpaper. The service calls
# this when the interval changes, so switching from off to daily starts
# counting from now instead of firing on the spot.
cmd_touch() {
  ensure_dir "$STATE_DIR"
  local at cur
  at=$(now_ms)
  cur=$(cat "$CURRENT_FILE" 2>/dev/null)
  if [[ -n $cur ]]; then
    jq -c --argjson at "$at" '.appliedAt = $at | .retryAt = 0' <<<"$cur" >"$CURRENT_FILE"
  else
    jq -cn --argjson at "$at" '{appliedAt: $at, retryAt: 0}' >"$CURRENT_FILE"
  fi
}

cmd_status() {
  ensure_config
  local src entries="[]" current dir themes_json
  dir=$(library_dir)
  for src in $SOURCE_IDS; do
    entries=$(jq -c --arg id "$src" --arg label "$(source_label "$src")" \
      --arg themes "$(source_themes "$src")" \
      --argjson on "$(source_enabled "$src" && printf true || printf false)" \
      --argjson match "$(source_matches_preferences "$src" && printf true || printf false)" \
      '. + [{id: $id, label: $label, themes: ($themes | split(" ")), enabled: $on, matches: $match}]' <<<"$entries")
  done

  current=$(cur_json)
  themes_json=$(jq -c '.themes' "$CONFIG_FILE" 2>/dev/null || printf '{}')

  jq -cn --argjson c "$current" --argjson s "$entries" \
    --argjson rotate "$(cfg rotateMinutes)" --argjson keep "$(cfg keepLast)" \
    --argjson themes "$themes_json" \
    --argjson lib "$(count_library "$dir")" \
    --arg libpath "$dir" --arg index "$INDEX_FILE" '{
      path: ($c.path // ""),
      source: ($c.source // ""),
      id: ($c.id // ""),
      theme: ($c.theme // ""),
      credit: ($c.credit // ""),
      link: ($c.link // ""),
      license: ($c.license // ""),
      width: ($c.width // 0),
      height: ($c.height // 0),
      appliedAt: ($c.appliedAt // 0),
      retryAt: ($c.retryAt // 0),
      rotateMinutes: $rotate,
      keepLast: $keep,
      themes: $themes,
      library: $lib,
      libraryPath: $libpath,
      indexFile: $index,
      sources: $s
    }'
}

# Asks every source and theme for one answer, without changing anything on
# screen. Used by hand and by the repository's checks.
cmd_verify() {
  ensure_config
  local wh min_w min_h src t n ok=0
  wh=$(screen_geometry); min_w=${wh% *}; min_h=${wh#* }
  for src in $SOURCE_IDS; do
    for t in $(source_themes "$src"); do
      n=$(fetch_candidates "$src" "$t" "$min_w" "$min_h" 2>/dev/null | jq 'length' 2>/dev/null)
      [[ ${n:-0} -gt 0 ]] 2>/dev/null || continue
      ok=$((ok + 1))
      printf '%s\t%s\t%s\n' "$src" "$t" "$n"
    done
  done
  ((ok > 0)) || die "no source responded"
  return 0
}

cmd_config() {
  case "${1:-show}" in
    show) ensure_config; cat "$CONFIG_FILE" ;;
    path) printf '%s\n' "$CONFIG_FILE" ;;
    get)  cfg "${2:?usage: fresque config get <key>}" ;;
    set)  cfg_set "${2:?usage: fresque config set <key> <value>}" "${3-}" ;;
    *)    die "unknown config subcommand: $1" ;;
  esac
}

usage() {
  cat <<'USAGE'
fresque: quality wallpapers for Omarchy

  fresque init                 Write the default config and install a first wallpaper
  fresque next                 Fetch and apply the next wallpaper
  fresque skip                 Block the current wallpaper and serve another one
  fresque status               Current wallpaper, rotation, themes and sources as JSON
  fresque verify               Ask every source and theme for one answer
  fresque clean [keep]         Trim the library to the newest <keep> images
  fresque touch                Re-arm the rotation clock without changing the picture
  fresque config show|get|set|path
  fresque help
USAGE
}

case "${1:-help}" in
  init)   cmd_init ;;
  next)   shift; cmd_next "$@" ;;
  skip)   cmd_skip ;;
  status) cmd_status ;;
  verify) cmd_verify ;;
  clean)  shift; ensure_config
          cmd_prune "${1:-$(cfg keepLast)}" "$(library_dir)"
          prune_theme_dir "$(theme_dir)" "$(cfg keepLast)"
          jq -cn --argjson n "$(count_library "$(library_dir)")" '{library: $n}' ;;
  touch)  cmd_touch ;;
  config) shift; cmd_config "$@" ;;
  help|-h|--help) usage ;;
  *) die "unknown command: $1 (try: fresque help)" ;;
esac
