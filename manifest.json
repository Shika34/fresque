  "repository": "https://github.com/Shika34/fresque",
  "keywords": [
    "wallpaper",
    "background",
    "photos",
    "rotation",
    "themes",
    "omarchy"
  ],
  "kinds": [
    "bar-widget",
    "service"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "service": "Service.qml"
  },
  "barWidget": {
